{
  "trailingSlash": "auto",
  "routes": [
    { "route": "/download", "rewrite": "/download.html" },
    { "route": "/organizations", "rewrite": "/organizations.html" },
    { "route": "/getting-started", "rewrite": "/getting-started.html" },
    { "route": "/imprint", "rewrite": "/imprint.html" },
    { "route": "/impressum", "redirect": "/imprint", "statusCode": 301 },
    { "route": "/privacy", "rewrite": "/privacy.html" },
    { "route": "/datenschutz", "redirect": "/privacy", "statusCode": 301 }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=(), usb=()",
    "Strict-Transport-Security": "max-age=31536000"
  },
  "mimeTypes": {
    ".svg": "image/svg+xml",
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
