<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Avalonia.Themes.Simple;assembly=Avalonia.Themes.Simple"
             x:Class="OS7.App.SoftwareUpdate.App">

  <Application.Styles>
    <!-- Avalonia's minimal base, FIRST, so OS/7's control themes override it.
         Not Fluent: every one of Fluent's decisions - rounded corners, accent
         colours, transitions - is something this design system would have to
         undo. docs/GUI-APPS-PLAN.md G8. -->
    <themes:SimpleTheme />

    <!-- The whole of OS/7's design system, in one include. -->
    <StyleInclude Source="avares://OS7.Ui/Theme/Os7Theme.axaml" />
  </Application.Styles>

</Application>
