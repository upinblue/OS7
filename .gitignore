# --- build outputs -----------------------------------------------------------
out/
*.iso
*.img
*.squashfs
*.log
*.buildlog

# --- live-build working state ------------------------------------------------
# build.sh stages into a container-local dir, but older/in-place builds and
# `lb config` runs can still litter the authored config tree.
build/config/.build/
build/config/chroot/
build/config/chroot.files
build/config/chroot.packages.*
build/config/binary/
build/config/binary.*
build/config/cache/
build/config/local/
build/config/config/

# --- local VM state (scripts/run-vm.sh) --------------------------------------
.vm/
*.qcow2

# --- OS noise ----------------------------------------------------------------
.DS_Store

# --- QEMU x86 builder VM (scripts/build-amd64-vm.sh) -------------------------
.vm-amd64/
