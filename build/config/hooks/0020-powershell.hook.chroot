#!/bin/bash
# OS/7 — install PowerShell 7 from the pinned upstream tarball.
#
# WHY THE TARBALL AND NOT A PACKAGE:
#   * Microsoft ships no PowerShell .deb for arm64 at all, and the amd64 .deb
#     only exists in the `noble` suite, not `resolute`. A tarball is the one
#     method that is identical on both architectures.
#   * README locks PowerShell to the OS/7 release train: it updates via
#     Update-OS7 into a new ZFS boot environment, NEVER a standalone
#     `apt upgrade powershell`. An unmanaged package - or the snap, which
#     self-refreshes on snapd's schedule - would break that guarantee.
#     A pinned tarball puts the version fully under OS/7's control.
#   * The .deb could not be used on resolute even if it existed for arm64: its
#     Depends list ends at libicu74, and resolute ships libicu78.
#
# Bump PWSH_VERSION and both hashes together when the release train moves.

set -euo pipefail

PWSH_VERSION="7.6.5"
SHA256_x64="b34ab3b19acac1d3d4d0d3cfdb02acf62f457b0b6a962ff008132033f7566844"
SHA256_arm64="ed4084f215d8bce2edd23aa7cb1f1e7b0818e41363a635a22065d2701b6141df"

ARCH="$(dpkg --print-architecture)"
case "${ARCH}" in
	amd64) PWSH_ARCH="x64";   PWSH_SHA="${SHA256_x64}"   ;;
	arm64) PWSH_ARCH="arm64"; PWSH_SHA="${SHA256_arm64}" ;;
	*) echo "OS/7 hook 0020: unsupported architecture '${ARCH}'" >&2; exit 1 ;;
esac

TARBALL="powershell-${PWSH_VERSION}-linux-${PWSH_ARCH}.tar.gz"
URL="https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/${TARBALL}"
DEST="/opt/microsoft/powershell/7"

echo "OS/7 hook 0020: installing PowerShell ${PWSH_VERSION} (${PWSH_ARCH})"

# ---------------------------------------------------------------------------
# Runtime dependency. The tarball carries NO dependency metadata, unlike a .deb,
# so nothing pulls this in for us. PowerShell is a .NET application and aborts
# at startup without ICU:
#
#   Couldn't find a valid ICU package installed on the system.
#   Process terminated.
#
# dotnet-sdk-10.0 in the base package list happens to pull libicu78 in today,
# but depending on that transitively means PowerShell breaks mysteriously the
# day .NET moves or is dropped. Install it here, next to the thing that needs it.
#
# Resolved from the archive rather than hardcoded: the soname version changes
# between Ubuntu releases (resolute is on 78), and a stale pin fails as an
# unhelpful "package not found".
# ---------------------------------------------------------------------------
ICU_PKG="$(apt-cache search --names-only '^libicu[0-9]+$' | awk '{print $1}' | sort -V | tail -n1)"
if [ -z "${ICU_PKG}" ]; then
	echo "OS/7 hook 0020: no libicu package found in the archive - PowerShell cannot run" >&2
	exit 1
fi
echo "OS/7 hook 0020: installing PowerShell's ICU dependency (${ICU_PKG})"
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${ICU_PKG}"

TMP="$(mktemp -d)"
trap 'rm -rf "${TMP}"' EXIT

# Retry: a 66MB fetch from GitHub inside the chroot is the single most
# failure-prone step in the build. A 2026-08-22 run died on
#   curl: (56) OpenSSL SSL_read: ... unexpected eof while reading
# midway through. One flaky transfer should not fail a whole ISO build.
curl -fsSL --retry 5 --retry-delay 3 --retry-connrefused --retry-all-errors \
	-o "${TMP}/${TARBALL}" "${URL}"

# Verify before unpacking anything into the image. A silent swap here would
# ship a compromised interactive shell to every OS/7 user.
echo "${PWSH_SHA}  ${TMP}/${TARBALL}" | sha256sum -c - \
	|| { echo "OS/7 hook 0020: SHA256 MISMATCH for ${TARBALL} - refusing to install" >&2; exit 1; }

install -d -m 0755 "${DEST}"
tar -xzf "${TMP}/${TARBALL}" -C "${DEST}"
chmod +x "${DEST}/pwsh"
ln -sf "${DEST}/pwsh" /usr/bin/pwsh

# ---------------------------------------------------------------------------
# .NET needs a working RNG, i.e. /dev/urandom.
#
# PowerShell is a .NET application and calls Guid.NewGuid() while initialising
# a runspace and while loading modules. With no usable /dev/urandom that throws
#   System.Security.Cryptography.CryptographicException
# and PowerShell then fails in a thoroughly misleading way: the binary still
# starts and `pwsh --version` prints happily, but NO on-disk module can load -
# surfacing much later as "The term 'Write-Host' is not recognized" or
# "no valid module file was found in any module directory".
#
# Reproduced 2026-08-22: identical chroot, /dev absent -> CryptographicException;
# /dev present -> everything works. A live-build chroot only gets /dev/pts
# mounted (lb_chroot_devpts), so whatever debootstrap laid down is all there is.
# ---------------------------------------------------------------------------
echo "OS/7 hook 0020: checking /dev for .NET's RNG"
printf 'OS/7 hook 0020:   /dev contains: %s\n' "$(ls /dev 2>/dev/null | tr '\n' ' ')"

# name major minor
for spec in "urandom 1 9" "random 1 8" "null 1 3" "zero 1 5"; do
	set -- ${spec}
	if [ ! -c "/dev/${1}" ]; then
		echo "OS/7 hook 0020:   /dev/${1} missing - creating it"
		mknod -m 0666 "/dev/${1}" c "${2}" "${3}" \
			|| echo "OS/7 hook 0020:   WARNING: could not create /dev/${1}" >&2
	fi
done

if head -c 32 /dev/urandom > /dev/null 2>&1; then
	echo "OS/7 hook 0020:   /dev/urandom is readable"
else
	echo "OS/7 hook 0020: /dev/urandom is not readable - .NET crypto cannot work" >&2
	exit 1
fi

# NOT added to /etc/shells: bash stays the real login shell (README "Shell").
# pwsh becomes the visible interactive shell via hook 0050 instead.

# ---------------------------------------------------------------------------
# Verify the install is COMPLETE, not merely present.
#
# `pwsh --version` is not sufficient and is actively misleading: the version
# banner, Import-Module-by-path and Get-Command are all compiled into the pwsh
# binary, so they work even when PowerShell's bundled module tree is missing.
# A 2026-08-22 build got all the way to "PowerShell 7.6.5" and then died later
# with "The term 'Write-Host' is not recognized" - Write-Host lives in
# Microsoft.PowerShell.Utility, on disk under $PSHOME/Modules.
#
# So: check the module tree exists, and exercise a cmdlet that can only come
# from it.
# ---------------------------------------------------------------------------
/usr/bin/pwsh --version

if [ ! -d "${DEST}/Modules/Microsoft.PowerShell.Utility" ]; then
	echo "OS/7 hook 0020: PowerShell module tree is incomplete after extraction" >&2
	echo "OS/7 hook 0020: expected ${DEST}/Modules/Microsoft.PowerShell.Utility" >&2
	echo "OS/7 hook 0020: ${DEST} contains:" >&2
	ls -la "${DEST}" >&2 || true
	echo "OS/7 hook 0020: ${DEST}/Modules contains:" >&2
	ls -la "${DEST}/Modules" >&2 || true
	exit 1
fi

echo "OS/7 hook 0020: verifying the PowerShell install"

# Filesystem facts come from BASH, never from PowerShell.
#
# Lesson from 2026-08-22: a diagnostic must not depend on the subsystem it is
# diagnosing. Earlier versions of this check reported through Write-Host, and
# built paths with Join-Path - both from the very modules that were failing to
# load - and so produced a confidently wrong "directory is empty" reading.
UTIL_DIR="${DEST}/Modules/Microsoft.PowerShell.Utility"
echo "OS/7 hook 0020:   files under ${DEST}: $(find "${DEST}" -type f | wc -l)"

if [ ! -f "${UTIL_DIR}/Microsoft.PowerShell.Utility.psd1" ]; then
	echo "OS/7 hook 0020: PowerShell's bundled module tree is incomplete." >&2
	echo "OS/7 hook 0020: missing ${UTIL_DIR}/Microsoft.PowerShell.Utility.psd1" >&2
	ls -la "${DEST}/Modules" >&2 || true
	exit 1
fi
echo "OS/7 hook 0020:   bundled module tree present ($(ls -1 "${DEST}/Modules" | wc -l) modules)"

# ---------------------------------------------------------------------------
# What is NOT verified here, and why.
#
# `Write-Host`, `Get-Module -ListAvailable`, and any Import-Module BY NAME
# cannot work at build time. live-build runs every hook inside chroot(2), and
# under chroot PowerShell's module DISCOVERY is broken: it probes PSModulePath
# entries with the character at index 1 dropped -
#     /root/... -> /oot/...   /usr/local/... -> /sr/local/...
#     /opt/microsoft/powershell/7/Modules -> /pt/microsoft/powershell/7/Modules
# so it finds nothing and reports "no valid module file was found in any module
# directory". Proven 2026-08-22 by satisfying the mangled path
# (/pt/microsoft/...): discovery immediately returned all 10 modules.
#
# It is chroot(2) itself, not the environment: the same binary on the same
# filesystem works when not chrooted, and fails when chrooted regardless of
# env or cwd. $env:PSModulePath itself reads back correctly - only discovery
# mangles it.
#
# This is therefore a BUILD-TIME artifact only. A booted OS/7 system is not
# chrooted and PowerShell behaves normally. Do NOT "fix" it by installing
# modules at the mangled paths.
#
# Verified on Docker Desktop / macOS arm64; not yet re-checked on a native
# Linux builder. Confirm on a booted ISO before treating as fully closed.
# ---------------------------------------------------------------------------
if /usr/bin/pwsh -NoLogo -NoProfile -Command 'Write-Host "OS/7 hook 0020:   cmdlets resolve (not chrooted?)"' 2>/dev/null; then
	:
else
	echo "OS/7 hook 0020:   NOTE: cmdlet discovery unavailable under chroot - expected, see comment above."
	echo "OS/7 hook 0020:   NOTE: must be re-verified on a booted system."
fi

echo "OS/7 hook 0020: done"
