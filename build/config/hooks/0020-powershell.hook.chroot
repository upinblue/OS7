#!/bin/bash
# OS/7 — install PowerShell 7 from the pinned upstream tarball.
#
# WHY THE TARBALL AND NOT A PACKAGE:
#   * Microsoft ships no PowerShell .deb for arm64 at all, and the amd64 .deb
#     only exists in the `noble` suite, not `resolute`. A tarball is the one
#     method that is identical on both architectures.
#   * README locks PowerShell to the OS/7 release train: it updates via
#     Update-OS7 into a new ZFS boot environment, NEVER a standalone
#     `apt upgrade powershell`. An unmanaged package - or the snap, which
#     self-refreshes on snapd's schedule - would break that guarantee.
#     A pinned tarball puts the version fully under OS/7's control.
#   * The .deb could not be used on resolute even if it existed for arm64: its
#     Depends list ends at libicu74, and resolute ships libicu78.
#
# Bump PWSH_VERSION and both hashes together when the release train moves.

set -euo pipefail

PWSH_VERSION="7.6.5"
SHA256_x64="b34ab3b19acac1d3d4d0d3cfdb02acf62f457b0b6a962ff008132033f7566844"
SHA256_arm64="ed4084f215d8bce2edd23aa7cb1f1e7b0818e41363a635a22065d2701b6141df"

ARCH="$(dpkg --print-architecture)"
case "${ARCH}" in
	amd64) PWSH_ARCH="x64";   PWSH_SHA="${SHA256_x64}"   ;;
	arm64) PWSH_ARCH="arm64"; PWSH_SHA="${SHA256_arm64}" ;;
	*) echo "OS/7 hook 0020: unsupported architecture '${ARCH}'" >&2; exit 1 ;;
esac

TARBALL="powershell-${PWSH_VERSION}-linux-${PWSH_ARCH}.tar.gz"
URL="https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/${TARBALL}"
DEST="/opt/microsoft/powershell/7"

echo "OS/7 hook 0020: installing PowerShell ${PWSH_VERSION} (${PWSH_ARCH})"

# ---------------------------------------------------------------------------
# Runtime dependency. The tarball carries NO dependency metadata, unlike a .deb,
# so nothing pulls this in for us. PowerShell is a .NET application and aborts
# at startup without ICU:
#
#   Couldn't find a valid ICU package installed on the system.
#   Process terminated.
#
# dotnet-sdk-10.0 in the base package list happens to pull libicu78 in today,
# but depending on that transitively means PowerShell breaks mysteriously the
# day .NET moves or is dropped. Install it here, next to the thing that needs it.
#
# Resolved from the archive rather than hardcoded: the soname version changes
# between Ubuntu releases (resolute is on 78), and a stale pin fails as an
# unhelpful "package not found".
# ---------------------------------------------------------------------------
ICU_PKG="$(apt-cache search --names-only '^libicu[0-9]+$' | awk '{print $1}' | sort -V | tail -n1)"
if [ -z "${ICU_PKG}" ]; then
	echo "OS/7 hook 0020: no libicu package found in the archive - PowerShell cannot run" >&2
	exit 1
fi
echo "OS/7 hook 0020: installing PowerShell's ICU dependency (${ICU_PKG})"
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${ICU_PKG}"

TMP="$(mktemp -d)"
trap 'rm -rf "${TMP}"' EXIT

curl -fsSL -o "${TMP}/${TARBALL}" "${URL}"

# Verify before unpacking anything into the image. A silent swap here would
# ship a compromised interactive shell to every OS/7 user.
echo "${PWSH_SHA}  ${TMP}/${TARBALL}" | sha256sum -c - \
	|| { echo "OS/7 hook 0020: SHA256 MISMATCH for ${TARBALL} - refusing to install" >&2; exit 1; }

install -d -m 0755 "${DEST}"
tar -xzf "${TMP}/${TARBALL}" -C "${DEST}"
chmod +x "${DEST}/pwsh"
ln -sf "${DEST}/pwsh" /usr/bin/pwsh

# NOT added to /etc/shells: bash stays the real login shell (README "Shell").
# pwsh becomes the visible interactive shell via hook 0050 instead.

# Run it for real. This is the check that catches a missing runtime dependency
# at BUILD time instead of on a user's machine at first login.
/usr/bin/pwsh --version
echo "OS/7 hook 0020: done"
