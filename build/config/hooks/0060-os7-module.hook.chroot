#!/bin/bash
# OS/7 — verify the PowerShell modules landed and are loadable.
#
# SIX modules since 2026-08-27: Zfs (the generic ZFS layer,
# docs/ZFS-POWERSHELL-PLAN.md), Net (the generic network layer,
# docs/POWERSHELL-SURFACE-PLAN.md P2), Time (the generic clock layer, same
# plan), Systemd (units and the journal, same plan), Directory (LDAP, X.500 and
# the Active Directory schema, same plan) and OS7 (the product layer
# on top of all five). All six are placed
# by build.sh, which copies powershell/<name>/ into the staged
# includes.chroot. That keeps ONE source of truth per module in the repo - the
# June-2026 tree carried a second baked-in copy that could drift.
#
# WHAT IS CHECKED, AND WHAT CANNOT BE:
#
#   Import-Module BY PATH works inside a chroot and is checked here. It is the
#   real correctness test anyway: the manifest parses, RootModule resolves, and
#   all three documented functions export.
#
#   Import-Module BY NAME cannot be checked at build time. live-build runs hooks
#   inside chroot(2), and under chroot PowerShell's module DISCOVERY mangles
#   every PSModulePath entry (drops the character at index 1), so it finds
#   nothing. See hook 0020 for the full evidence. That is a build-time artifact:
#   a booted system is not chrooted and `Import-Module OS7` works there.
#
# All output goes through [Console]::WriteLine, never Write-Host: Write-Host
# lives in Microsoft.PowerShell.Utility, which is exactly what does not resolve
# under chroot. Reporting through it would break this check for no reason.

#   AND WHAT STILL CANNOT BE, which is the thing to read before adding a check
#   here: a hook may import a module by path and inspect what it EXPORTS. It
#   must not CALL a function that needs a bundled cmdlet — Get-Content,
#   ConvertFrom-Json, Where-Object and friends autoload by NAME out of
#   $PSHOME/Modules, and that is exactly the lookup #14 mangles. BUILD-NOTES #38
#   is the measurement, including the part where an overlay chroot disagreed and
#   live-build's chroot had the last word.
#
#   So `Test-ZfsModule` is NOT run here, although it is written to be run
#   somewhere automatic. It runs in installer/testing/check-image.py, against
#   the finished artefact, and authoritatively in run-zfs.py on a booted VM.

set -euo pipefail

MODULES_ROOT="/usr/local/share/powershell/Modules"

# Zfs first: it is Layer 2 and OS7 sits on top of it
# (docs/ZFS-POWERSHELL-PLAN.md Z1).
check_module() {
	local name="$1"; shift
	local dir="${MODULES_ROOT}/${name}"
	local manifest="${dir}/${name}.psd1"
	local expected="$*"

	echo "OS/7 hook 0060: verifying the ${name} module at ${dir}"

	if [ ! -f "${manifest}" ] || [ ! -f "${dir}/${name}.psm1" ]; then
		echo "OS/7 hook 0060: ${name} module missing from ${dir}" >&2
		echo "OS/7 hook 0060: build.sh should have staged it from powershell/${name}/" >&2
		ls -la "${dir}" >&2 2>&1 || true
		exit 1
	fi

	chown -R root:root "${dir}"
	find "${dir}" -type f -exec chmod 0644 {} +
	find "${dir}" -type d -exec chmod 0755 {} +

	/usr/bin/pwsh -NoLogo -NoProfile -Command "
		\$ErrorActionPreference = 'Stop'
		try {
			Import-Module '${manifest}' -Force -ErrorAction Stop
			\$expected = '${expected}'.Split(' ')
			\$actual   = (Get-Command -Module ${name}).Name
			foreach (\$f in \$expected) {
				if (\$actual -notcontains \$f) { throw '${name} module does not export ' + \$f }
			}
			[Console]::WriteLine('OS/7 hook 0060:   ${name}: manifest loads, exports: ' + (\$actual -join ', '))
		} catch {
			[Console]::WriteLine('OS/7 hook 0060:   ${name}: FAILED: ' + \$_.Exception.Message)
			exit 1
		}
	"
}

check_module Zfs Get-Zpool Get-ZpoolStatus Get-ZfsDataset Get-ZfsSnapshot \
	Get-ZfsProperty Get-ZfsSpace Format-ZfsSize Clear-ZpoolLabel Test-ZfsModule
# Net carries the netplan document generator, and it is named here for a reason
# specific to it: the SAME document is generated in C# by
# NetworkPlan.ToNetplanYaml, and P3 exists to collapse the two into one. Until
# it does, an image that shipped without New-NetplanDocument would leave the
# cmdlet half of that plan unshippable while every check that compares the two
# went on passing on the build host.
#
# The readers are named too, and for a reason this hook has just been paid by:
# Export-ModuleMember and the manifest's FunctionsToExport are TWO filters, and
# widening one without the other leaves a function that exists, imports and is
# invisible. Nothing in the module misbehaves; it simply is not there.
check_module Net New-NetplanDocument Get-NetLink Get-NetRoute Get-NetRadio \
	Get-NetplanConfiguration Test-NetModule \
	Set-NetplanDocument Remove-NetplanDocument Invoke-NetplanApply \
	Wait-NetLinkAddress
# Time carries chrony's CSV parsing. Its field COUNTS are checked inside the
# module rather than assumed, so a chrony that changed format fails loudly - but
# that only helps if the module is on the image at all, which is what this line
# is for.
check_module Time Get-ChronyTracking Get-ChronySource Get-ChronySourceFile \
	Set-ChronySource Sync-ChronyClock Get-SystemTimeZone Set-SystemTimeZone \
	Get-SystemClock Test-TimeModule
# Systemd's fixtures include a journal MESSAGE that is a BYTE ARRAY, which is
# the case that turns the message column into System.Object[] if the parser
# assumes a string. Naming the module here is what stops an image shipping
# without the parser that handles it.
check_module Systemd Get-SystemdUnit Start-SystemdUnit Stop-SystemdUnit \
	Restart-SystemdUnit Set-SystemdUnitStartup Update-SystemdUnit Get-SystemdJournal \
	Test-SystemdModule
# Directory is the fifth generic layer, and one name in this list is the reason
# the line exists: Connect-DirectoryServer. Everything else the module exports is
# a converter or an escaper - RFC 4514, RFC 4515, FILETIME, objectSid,
# userAccountControl - and every one of them would pass a self-test on a machine
# that can reach no directory at all. An image that shipped the converters and
# not the connection would answer every question about LDAP correctly and be
# unable to open a socket to a domain controller, which is the failure this line
# is here to make impossible rather than merely unlikely.
#
# Test-DirectoryModule is named for the same reason Test-ZfsModule is above: it
# is what check-image.py runs against the finished artefact, and a module that
# shipped without it fails that check by producing no verdict rather than a bad
# one.
check_module Directory Connect-DirectoryServer Disconnect-DirectoryServer \
	Get-DirectoryWhoAmI Get-DirectoryRootDse \
	Search-Directory New-DirectoryEntry Set-DirectoryEntry \
	Remove-DirectoryEntry Move-DirectoryEntry Set-DirectoryPassword \
	ConvertTo-DirectoryFilterValue ConvertTo-DirectoryDnValue \
	ConvertTo-DirectoryDomainDn Split-DirectoryDn \
	Get-DirectoryAttributeValues Get-DirectoryAttributeScalar \
	ConvertFrom-DirectoryFileTime ConvertFrom-DirectoryGeneralizedTime \
	ConvertFrom-DirectorySid ConvertFrom-DirectoryGuid \
	Get-DirectoryAccountControl Get-DirectoryErrorMeaning \
	Get-DirectoryLdapException ConvertTo-DirectoryInt64 \
	Join-DirectoryRealm Remove-DirectoryRealm Update-DirectoryRealm \
	Get-DirectoryRealmConfiguration Get-DirectoryKeytabPrincipal \
	New-DirectorySssdConfiguration Get-DirectoryIdentityResolution \
	Get-DirectoryTicket New-DirectoryTicket Remove-DirectoryTicket \
	Test-DirectoryTool Test-DirectoryModule
# The boot-environment cmdlets are named here rather than left to the stub that
# used to stand in for them: they are what Restore-OS7 AND Update-OS7 are built
# out of (docs/SESSION-BOOT-ENVIRONMENTS.md), they are staged from the same one
# source, and a check that only ever asked about a stub would have gone on
# passing if they vanished.
#
# The update train is named for the same reason since 2026-08-27. It lives in
# OS7.Update.ps1 — the sixth dot-sourced file — and Get-OS7Release is the half
# of it an image without a repository can still be asked about, which makes it
# the one that would fail quietly if the file were missing.
#
# The backup surface is named for the same reason and for one more: it lives in
# files that OS7.psm1 DOT-SOURCES, so a staging that copied the .psm1 and missed
# a .ps1 beside it is a real failure mode of `cp -a`. The import throws on a
# missing file and this is what turns that into a build failure.
#
# Get-OS7Home and Move-OS7Home are named for a third reason: they are what an
# operator reaches for when BUILD-NOTES #74 has already happened to a machine,
# so an image shipping without them is an image that cannot repair itself.
#
# Get-OS7Version is named for a fourth: it is the ONLY way an operator can ask
# an installed machine which OS/7 it is (docs/IDENTITY-PLAN.md §7), and it is
# also the first cmdlet in this module that needs OS7.format.ps1xml — a manifest
# whose FormatsToProcess names a file `cp -a` did not bring makes the module
# fail to IMPORT, which this check turns into a build failure rather than a
# first-login one.
check_module OS7 Get-OS7Version Set-OS7Mode Update-OS7 Restore-OS7 \
	Get-OS7BootEnvironment New-OS7BootEnvironment \
	Set-OS7BootEnvironment Remove-OS7BootEnvironment \
	Get-OS7BackupPolicy Set-OS7BackupPolicy Enable-OS7Backup Disable-OS7Backup \
	Start-OS7Backup Get-OS7BackupStatus Get-OS7BackupCoverage \
	Get-OS7BackupTarget New-OS7BackupTarget Remove-OS7BackupTarget \
	Test-OS7BackupTarget Start-OS7BackupReplication \
	Mount-OS7BackupTarget Dismount-OS7BackupTarget \
	Get-OS7FileVersion Restore-OS7File Test-OS7Backup \
	Get-OS7Home Move-OS7Home \
	Get-OS7Release Set-OS7UpdateChannel Test-OS7Update \
	Get-OS7NetworkAdapter Get-OS7NetworkConfiguration \
	Set-OS7NetworkAdapter Test-OS7Network Get-OS7Endpoint \
	Set-OS7TimeZone Get-OS7Time Get-OS7TimeSynchronization \
	Set-OS7TimeSynchronization Sync-OS7Time \
	Get-OS7Remoting Enable-OS7Remoting Disable-OS7Remoting \
	Get-OS7Service Start-OS7Service Stop-OS7Service Restart-OS7Service \
	Set-OS7Service Get-OS7Log Get-OS7InstallLog \
	Get-OS7EntraStatus Get-OS7IntuneEnrollment Get-OS7ArcStatus \
	Get-OS7ManagementStatus

# A file that is PRESENT AND EMPTY still imports and still exports nothing, so
# the export check above cannot see it. `cp -a` onto a full filesystem produces
# exactly that.
#
# OS7.format.ps1xml rides along in the same list. It is not dot-sourced — it is
# what FormatsToProcess names — but it fails the same way for the same reason,
# and an empty one is a `Get-OS7Version` that prints a bare property bag on a
# machine somebody is trying to identify.
#
# The three Active Directory files join the list on 2026-08-27, and for now they
# carry more weight than the rest of it: check_module OS7 above does NOT name the
# AD cmdlets, so this loop is the only thing standing between a `cp -a` that
# dropped one of them and an image whose OS7 module imports cleanly, prints a
# version, and has no Active Directory surface at all. An empty dot-sourced file
# is not an import error - `. empty.ps1` succeeds and defines nothing - so the
# module comes up looking healthy. Naming those cmdlets in the export list above
# is the second half of this guard and is still owed.
for part in OS7.Backup.ps1 OS7.BackupTarget.ps1 OS7.BackupRestore.ps1 \
	OS7.BackupSelfTest.ps1 OS7.Home.ps1 OS7.Network.ps1 OS7.Time.ps1 OS7.Remoting.ps1 OS7.Service.ps1 OS7.Management.ps1 \
	OS7.Directory.ps1 OS7.DirectoryObject.ps1 OS7.Domain.ps1 \
	OS7.Update.ps1 \
	OS7.format.ps1xml os7-endpoints.json; do
	if [ ! -s "${MODULES_ROOT}/OS7/${part}" ]; then
		echo "OS/7 hook 0060: ${MODULES_ROOT}/OS7/${part} is missing or empty" >&2
		exit 1
	fi
done
echo "OS/7 hook 0060:   OS7: the dot-sourced files and the format file are present"

# The fixtures travel with the Zfs module so that Test-ZfsModule can run without
# ZFS. Their absence would not break an import, so it is checked separately -
# otherwise the self-test would silently degrade to testing only the converters.
FIX="${MODULES_ROOT}/Zfs/tests/fixtures"
n=$(find "${FIX}" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
if [ "${n}" -lt 5 ]; then
	echo "OS/7 hook 0060: only ${n} JSON fixtures under ${FIX}; expected at least 5" >&2
	echo "OS/7 hook 0060: re-capture them with installer/testing/run-zfs.py capture" >&2
	exit 1
fi
echo "OS/7 hook 0060:   Zfs: ${n} recorded ZFS captures shipped for the self-test"

# The same argument for Net, and the same failure mode: the fixtures are
# recorded `ip -j` and `rfkill -J` output, their absence would not break an
# import, and without them Test-NetModule silently degrades from checking the
# readers to checking the YAML escaping alone.
NETFIX="${MODULES_ROOT}/Net/tests/fixtures"
nn=$(find "${NETFIX}" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
if [ "${nn}" -lt 4 ]; then
	echo "OS/7 hook 0060: only ${nn} JSON fixtures under ${NETFIX}; expected at least 4" >&2
	echo "OS/7 hook 0060: see powershell/Net/tests/fixtures/README for how they were taken" >&2
	exit 1
fi
echo "OS/7 hook 0060:   Net: ${nn} recorded ip/rfkill captures shipped for the self-test"

echo "OS/7 hook 0060:   NOTE: 'Import-Module OS7' by name is not testable in a"
echo "OS/7 hook 0060:   NOTE: chroot; verify it on a booted system."
echo "OS/7 hook 0060: done"
