#!/bin/bash
# OS/7 — verify the OS7 PowerShell module landed and is loadable.
#
# The module is placed by build.sh, which copies powershell/OS7/ into the staged
# includes.chroot. That keeps ONE source of truth in the repo - the June-2026
# tree carried a second baked-in copy that could drift.
#
# WHAT IS CHECKED, AND WHAT CANNOT BE:
#
#   Import-Module BY PATH works inside a chroot and is checked here. It is the
#   real correctness test anyway: the manifest parses, RootModule resolves, and
#   all three documented functions export.
#
#   Import-Module BY NAME cannot be checked at build time. live-build runs hooks
#   inside chroot(2), and under chroot PowerShell's module DISCOVERY mangles
#   every PSModulePath entry (drops the character at index 1), so it finds
#   nothing. See hook 0020 for the full evidence. That is a build-time artifact:
#   a booted system is not chrooted and `Import-Module OS7` works there.
#
# All output goes through [Console]::WriteLine, never Write-Host: Write-Host
# lives in Microsoft.PowerShell.Utility, which is exactly what does not resolve
# under chroot. Reporting through it would break this check for no reason.

set -euo pipefail

MODULE_DIR="/usr/local/share/powershell/Modules/OS7"
MANIFEST="${MODULE_DIR}/OS7.psd1"

echo "OS/7 hook 0060: verifying the OS7 module at ${MODULE_DIR}"

if [ ! -f "${MANIFEST}" ] || [ ! -f "${MODULE_DIR}/OS7.psm1" ]; then
	echo "OS/7 hook 0060: OS7 module missing from ${MODULE_DIR}" >&2
	echo "OS/7 hook 0060: build.sh should have staged it from powershell/OS7/" >&2
	ls -la "${MODULE_DIR}" >&2 2>&1 || true
	exit 1
fi

chown -R root:root "${MODULE_DIR}"
find "${MODULE_DIR}" -type f -exec chmod 0644 {} +
find "${MODULE_DIR}" -type d -exec chmod 0755 {} +

/usr/bin/pwsh -NoLogo -NoProfile -Command "
	\$ErrorActionPreference = 'Stop'
	try {
		Import-Module '${MANIFEST}' -Force -ErrorAction Stop
		\$expected = @('Set-OS7Mode','Update-OS7','Restore-OS7')
		\$actual   = (Get-Command -Module OS7).Name
		foreach (\$f in \$expected) {
			if (\$actual -notcontains \$f) { throw \"OS7 module does not export \$f\" }
		}
		[Console]::WriteLine('OS/7 hook 0060:   manifest loads, exports: ' + (\$actual -join ', '))
	} catch {
		[Console]::WriteLine('OS/7 hook 0060:   FAILED: ' + \$_.Exception.Message)
		exit 1
	}
"

echo "OS/7 hook 0060:   NOTE: 'Import-Module OS7' by name is not testable in a"
echo "OS/7 hook 0060:   NOTE: chroot; verify it on a booted system."
echo "OS/7 hook 0060: done"
