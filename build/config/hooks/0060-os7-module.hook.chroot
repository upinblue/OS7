#!/bin/bash
# OS/7 — verify the OS7 PowerShell module landed and is usable.
#
# The module itself is placed by build.sh, which copies powershell/OS7/ into the
# staged includes.chroot. That keeps ONE source of truth in the repo - the
# June-2026 tree carried a second, drifting copy baked in under includes.chroot,
# which is exactly what this avoids.
#
# Two DIFFERENT things are checked, because they fail for different reasons:
#
#   1. Does the manifest load at all?  -> Import-Module by explicit PATH.
#      This is the real correctness check: manifest parses, RootModule resolves,
#      all three functions export. Independent of PSModulePath.
#
#   2. Can a user type `Import-Module OS7`?  -> import by NAME.
#      This depends on /usr/local/share/powershell/Modules being on
#      PSModulePath, which is environment-dependent. A build on 2026-08-22
#      failed here with "no valid module file was found in any module
#      directory" even though the files were present and the same check passed
#      in an equivalent container - so when this fails it now DUMPS the
#      evidence instead of just the error.

set -euo pipefail

MODULE_DIR="/usr/local/share/powershell/Modules/OS7"
MANIFEST="${MODULE_DIR}/OS7.psd1"

echo "OS/7 hook 0060: verifying the OS7 module at ${MODULE_DIR}"

if [ ! -f "${MANIFEST}" ] || [ ! -f "${MODULE_DIR}/OS7.psm1" ]; then
	echo "OS/7 hook 0060: OS7 module missing from ${MODULE_DIR}" >&2
	echo "OS/7 hook 0060: build.sh should have staged it from powershell/OS7/" >&2
	ls -la "${MODULE_DIR}" 2>&1 | sed 's/^/OS\/7 hook 0060:   /' >&2 || true
	exit 1
fi

chown -R root:root "${MODULE_DIR}"
find "${MODULE_DIR}" -type f -exec chmod 0644 {} +
find "${MODULE_DIR}" -type d -exec chmod 0755 {} +

# --- 1. Load by explicit path: does the module actually work? ----------------
/usr/bin/pwsh -NoLogo -NoProfile -Command "
	\$ErrorActionPreference = 'Stop'
	Import-Module '${MANIFEST}'
	\$expected = @('Set-OS7Mode','Update-OS7','Restore-OS7')
	\$actual   = (Get-Command -Module OS7).Name
	foreach (\$f in \$expected) {
		if (\$actual -notcontains \$f) { throw \"OS7 module does not export \$f\" }
	}
	Write-Host \"OS/7 hook 0060: manifest loads, exports: \$(\$actual -join ', ')\"
"

# --- 2. Discoverable by name, the way a user will type it -------------------
if /usr/bin/pwsh -NoLogo -NoProfile -Command "
		\$ErrorActionPreference = 'Stop'
		Import-Module OS7
		exit 0
	" 2>/dev/null; then
	echo "OS/7 hook 0060: discoverable as 'Import-Module OS7'"
else
	echo "OS/7 hook 0060: FAILED - module loads by path but NOT by name." >&2
	echo "OS/7 hook 0060: PSModulePath as pwsh sees it:" >&2
	/usr/bin/pwsh -NoLogo -NoProfile -Command '$env:PSModulePath -split ":" | ForEach-Object { "  " + $_ }' >&2 || true
	echo "OS/7 hook 0060: contents of ${MODULE_DIR}:" >&2
	ls -la "${MODULE_DIR}" >&2 || true
	echo "OS/7 hook 0060: pwsh sees these OS7 modules:" >&2
	/usr/bin/pwsh -NoLogo -NoProfile -Command 'Get-Module -ListAvailable OS7 | Format-List Name,Path,Version' >&2 || true
	exit 1
fi

echo "OS/7 hook 0060: done"
