#!/bin/bash
# OS/7 — verify the PowerShell modules landed and are loadable.
#
# TWO modules since 2026-08-25: Zfs (the generic ZFS layer,
# docs/ZFS-POWERSHELL-PLAN.md) and OS7 (the product layer on top of it). Both
# are placed by build.sh, which copies powershell/<name>/ into the staged
# includes.chroot. That keeps ONE source of truth per module in the repo - the
# June-2026 tree carried a second baked-in copy that could drift.
#
# WHAT IS CHECKED, AND WHAT CANNOT BE:
#
#   Import-Module BY PATH works inside a chroot and is checked here. It is the
#   real correctness test anyway: the manifest parses, RootModule resolves, and
#   all three documented functions export.
#
#   Import-Module BY NAME cannot be checked at build time. live-build runs hooks
#   inside chroot(2), and under chroot PowerShell's module DISCOVERY mangles
#   every PSModulePath entry (drops the character at index 1), so it finds
#   nothing. See hook 0020 for the full evidence. That is a build-time artifact:
#   a booted system is not chrooted and `Import-Module OS7` works there.
#
# All output goes through [Console]::WriteLine, never Write-Host: Write-Host
# lives in Microsoft.PowerShell.Utility, which is exactly what does not resolve
# under chroot. Reporting through it would break this check for no reason.

#   AND WHAT STILL CANNOT BE, which is the thing to read before adding a check
#   here: a hook may import a module by path and inspect what it EXPORTS. It
#   must not CALL a function that needs a bundled cmdlet — Get-Content,
#   ConvertFrom-Json, Where-Object and friends autoload by NAME out of
#   $PSHOME/Modules, and that is exactly the lookup #14 mangles. BUILD-NOTES #38
#   is the measurement, including the part where an overlay chroot disagreed and
#   live-build's chroot had the last word.
#
#   So `Test-ZfsModule` is NOT run here, although it is written to be run
#   somewhere automatic. It runs in installer/testing/check-image.py, against
#   the finished artefact, and authoritatively in run-zfs.py on a booted VM.

set -euo pipefail

MODULES_ROOT="/usr/local/share/powershell/Modules"

# Zfs first: it is Layer 2 and OS7 sits on top of it
# (docs/ZFS-POWERSHELL-PLAN.md Z1).
check_module() {
	local name="$1"; shift
	local dir="${MODULES_ROOT}/${name}"
	local manifest="${dir}/${name}.psd1"
	local expected="$*"

	echo "OS/7 hook 0060: verifying the ${name} module at ${dir}"

	if [ ! -f "${manifest}" ] || [ ! -f "${dir}/${name}.psm1" ]; then
		echo "OS/7 hook 0060: ${name} module missing from ${dir}" >&2
		echo "OS/7 hook 0060: build.sh should have staged it from powershell/${name}/" >&2
		ls -la "${dir}" >&2 2>&1 || true
		exit 1
	fi

	chown -R root:root "${dir}"
	find "${dir}" -type f -exec chmod 0644 {} +
	find "${dir}" -type d -exec chmod 0755 {} +

	/usr/bin/pwsh -NoLogo -NoProfile -Command "
		\$ErrorActionPreference = 'Stop'
		try {
			Import-Module '${manifest}' -Force -ErrorAction Stop
			\$expected = '${expected}'.Split(' ')
			\$actual   = (Get-Command -Module ${name}).Name
			foreach (\$f in \$expected) {
				if (\$actual -notcontains \$f) { throw '${name} module does not export ' + \$f }
			}
			[Console]::WriteLine('OS/7 hook 0060:   ${name}: manifest loads, exports: ' + (\$actual -join ', '))
		} catch {
			[Console]::WriteLine('OS/7 hook 0060:   ${name}: FAILED: ' + \$_.Exception.Message)
			exit 1
		}
	"
}

check_module Zfs Get-Zpool Get-ZpoolStatus Get-ZfsDataset Get-ZfsSnapshot \
	Get-ZfsProperty Get-ZfsSpace Format-ZfsSize Clear-ZpoolLabel Test-ZfsModule
# The boot-environment cmdlets are named here rather than left to the two stubs:
# they are what Restore-OS7 is built out of (docs/SESSION-BOOT-ENVIRONMENTS.md),
# they are staged from the same one source, and a check that only ever asked
# about the stubs would have gone on passing if they vanished.
#
# The backup surface is named for the same reason and for one more: it lives in
# four files that OS7.psm1 DOT-SOURCES, so a staging that copied the .psm1 and
# missed a .ps1 beside it is a real failure mode of `cp -a`. The import throws
# on a missing file and this is what turns that into a build failure.
check_module OS7 Set-OS7Mode Update-OS7 Restore-OS7 \
	Get-OS7BootEnvironment New-OS7BootEnvironment \
	Set-OS7BootEnvironment Remove-OS7BootEnvironment \
	Get-OS7BackupPolicy Set-OS7BackupPolicy Enable-OS7Backup Disable-OS7Backup \
	Start-OS7Backup Get-OS7BackupStatus Get-OS7BackupCoverage \
	Get-OS7BackupTarget New-OS7BackupTarget Remove-OS7BackupTarget \
	Test-OS7BackupTarget Start-OS7BackupReplication \
	Mount-OS7BackupTarget Dismount-OS7BackupTarget \
	Get-OS7FileVersion Restore-OS7File Test-OS7Backup

# A file that is PRESENT AND EMPTY still imports and still exports nothing, so
# the export check above cannot see it. `cp -a` onto a full filesystem produces
# exactly that.
for part in OS7.Backup.ps1 OS7.BackupTarget.ps1 OS7.BackupRestore.ps1 OS7.BackupSelfTest.ps1; do
	if [ ! -s "${MODULES_ROOT}/OS7/${part}" ]; then
		echo "OS/7 hook 0060: ${MODULES_ROOT}/OS7/${part} is missing or empty" >&2
		exit 1
	fi
done
echo "OS/7 hook 0060:   OS7: the four backup files are present and non-empty"

# The fixtures travel with the Zfs module so that Test-ZfsModule can run without
# ZFS. Their absence would not break an import, so it is checked separately -
# otherwise the self-test would silently degrade to testing only the converters.
FIX="${MODULES_ROOT}/Zfs/tests/fixtures"
n=$(find "${FIX}" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
if [ "${n}" -lt 5 ]; then
	echo "OS/7 hook 0060: only ${n} JSON fixtures under ${FIX}; expected at least 5" >&2
	echo "OS/7 hook 0060: re-capture them with installer/testing/run-zfs.py capture" >&2
	exit 1
fi
echo "OS/7 hook 0060:   Zfs: ${n} recorded ZFS captures shipped for the self-test"

echo "OS/7 hook 0060:   NOTE: 'Import-Module OS7' by name is not testable in a"
echo "OS/7 hook 0060:   NOTE: chroot; verify it on a booted system."
echo "OS/7 hook 0060: done"
