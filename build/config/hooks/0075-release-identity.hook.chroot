#!/bin/bash
# OS/7 — the release identity: /etc/os-release branding, and the manifest.
#
# This is the hook that turns the pin (docs/RELEASE-AND-UPDATE-PLAN.md §3) into
# something the finished image carries. It runs LAST, because everything it
# records has to already be installed for it to be measurable.
#
# It does two jobs and they are deliberately in one hook: the branded
# IMAGE_VERSION in /etc/os-release and the "version" in release.json are the
# same number, and two hooks writing it from one file is two chances to disagree.
#
# INPUTS (staged by build/build.sh):
#   /usr/lib/os7/release.conf   the pin - what was ASKED FOR
#   /usr/lib/os7/build.conf     version, timestamp, git provenance
#
# OUTPUTS (since 2026-08-28 the identity itself is os7-release's, installed by
# hook 0022 — this hook VERIFIES it and writes the two files only an image
# measurement can produce):
#   /usr/lib/os7/packages.manifest  every package and its version, sorted
#   /usr/lib/os7/image.json         what this MATERIALISATION turned out to
#                                   contain — the measured superset of the
#                                   release facts os7-release declares at
#                                   /usr/lib/os7/release.json. Two files, two
#                                   authors, two names: the seam
#                                   SESSION-OS7-REPOSITORY.md §5 recorded is
#                                   resolved the way C9 implies — the release
#                                   says what it IS, the image says what it
#                                   turned out to hold.

set -euo pipefail

echo "OS/7 hook 0075: release identity"

for conf in /usr/lib/os7/release.conf /usr/lib/os7/build.conf; do
	[ -r "${conf}" ] || {
		echo "OS/7 hook 0075: ${conf} missing - build.sh did not stage the pin" >&2
		exit 1
	}
done

# `set -a` so everything sourced is EXPORTED. The python blocks below read their
# inputs from the environment rather than by interpolation, which is what keeps a
# value containing a quote from rewriting the program that is supposed to escape
# it.
set -a
# shellcheck source=/dev/null
. /usr/lib/os7/release.conf
# shellcheck source=/dev/null
. /usr/lib/os7/build.conf
set +a

ARCH="$(dpkg --print-architecture)"

# THE DISPLAY RULE IS NOT IMPLEMENTED HERE. docs/IDENTITY-PLAN.md §5 is
# implemented in C#, in PowerShell, in Python and in shell, and four is already
# one more than anybody can hold in their head; build.sh applies the shell one
# (build/lib/version-rule.sh) and hands the rendered strings in through
# build.conf. A fifth copy inside a chroot hook would be the one nothing can
# reach to check.
#
# Missing means an old build.conf, and that has to stop the build rather than
# produce an image whose PRETTY_NAME is the empty string.
for var in OS7_VERSION OS7_CHANNEL OS7_VERSION_SHORT OS7_PRODUCT; do
	eval "value=\${${var}-}"
	if [ -z "${value}" ]; then
		echo "OS/7 hook 0075: ${var} is not set - build.sh did not hand it in." >&2
		echo "OS/7 hook 0075: build/lib/version-rule.sh renders it into build.conf." >&2
		exit 1
	fi
done

echo "OS/7 hook 0075:   ${OS7_PRODUCT}, build ${OS7_VERSION}, ${ARCH}"

# Read a field the way every real consumer does — by SOURCING the file, never by
# scraping it. os-release(5) defines it as shell-compatible, and a reader that
# strips one quote style agrees with a correct file right up to the first value
# quoted the other way (BUILD-NOTES #37). In a subshell, because sourcing it
# here would overwrite this script's own NAME and VERSION_ID.
osrel_get() { ( . /etc/os-release; eval "printf '%s' \"\${$1-}\"" ); }

# ---------------------------------------------------------------------------
# 1. /etc/os-release (docs/IDENTITY-PLAN.md §4, release plan §3.5, D8)
#
# THE FIELDS THAT MUST NOT BE TOUCHED:
#     ID  ID_LIKE  VERSION_ID  VERSION  VERSION_CODENAME  NAME
#
# The first three are D8's list and are Intune's: its "Allowed distributions"
# rule is evaluated by the SERVICE from what the agent reports, and
# `intune-agent` reads ID and VERSION_ID out of this file.
#
# **NAME IS ON THAT LIST SINCE 2026-08-26, AND IT USED TO BE BRANDED.**
# BUILD-NOTES #80: Microsoft's Azure Arc onboarding script reads NAME, matches
# `*buntu*`, and exits 133 on anything else — it never reaches ID=ubuntu at all.
# D8's reasoning ("Intune matches on ID, so NAME is free") was a guess about one
# vendor tool out of three, and it was wrong for that one. VERSION and
# VERSION_CODENAME join the list for the cheaper reason: `intune-agent` reads
# VERSION too, the contract is undocumented, and leaving a field alone costs
# nothing.
#
# So the brand lives in fields nobody else's software reads. IMAGE_ID +
# IMAGE_VERSION are the correct ones rather than merely free ones: os-release(5)
# defines BUILD_ID as the image originally used as the INSTALLATION BASE and
# says explicitly that it does not change during incremental updates — the
# opposite of what is wanted — while IMAGE_ID/IMAGE_VERSION are defined for
# systems "prepared, built, shipped and updated as comprehensive, consistent"
# units, which is exactly the OS/7 release train.
#
# PRETTY_NAME is branded and is the ONE branded field that is provisional
# (IDENTITY-PLAN I3/IL1): `intune-agent` reads it through a function called
# `tryReadPrettyName`, in its HTTP and token layer, which reads as telemetry
# rather than compliance — but strings in a binary say what a program CAN read,
# not what it sends. If a first enrolment says otherwise, this line reverts and
# nothing else moves, because no other surface depends on it (I1).
#
# NOTE: /etc/os-release on Ubuntu is a symlink to ../usr/lib/os-release, and
# base-files owns that file as a CONFFILE. So an `apt` run that reinstalls
# base-files can revert this, which is why the update sequence re-asserts it
# (release plan §4.2 step 6). Writing through the symlink here would work today
# and break silently the day the symlink goes away; write the real file.
# ---------------------------------------------------------------------------
OSREL=/usr/lib/os-release
[ -f "${OSREL}" ] || { echo "OS/7 hook 0075: ${OSREL} does not exist" >&2; exit 1; }

# VERIFY-ONLY SINCE 2026-08-28. The identity is WRITTEN by os7-release (hook
# 0022 installs it): the package dpkg-diverts /usr/lib/os-release and its
# postinst derives the branded file from base-files' copy through
# /usr/lib/os7/os-release-identity.py — the one implementation of the rewrite,
# which this hook's inline python used to be the second of. What this hook
# keeps is every READBACK: the branded values took, the untouchable fields
# match base-files' own copy at .distrib, the literal contract holds, and
# PRIVACY_POLICY_URL is gone. The diversion is asked of dpkg first, because
# a branded file WITHOUT the diversion is the pre-package world where any
# base-files upgrade reverts it (UL10).
if ! dpkg-divert --list /usr/lib/os-release | grep -q os7-release; then
	echo "OS/7 hook 0075: /usr/lib/os-release is not diverted by os7-release." >&2
	echo "OS/7 hook 0075: hook 0022 should have installed the package (UL10)." >&2
	exit 1
fi
if [ ! -s /usr/lib/os-release.distrib ]; then
	echo "OS/7 hook 0075: base-files' own copy is missing at /usr/lib/os-release.distrib" >&2
	exit 1
fi

# What the untouchable fields say in BASE-FILES' OWN COPY. Compared against the
# branded file below, so the check is "the brand invented nothing" — the
# generator's contract is that these fields are derived, never composed
# (IDENTITY-PLAN I4).
PROTECTED_BEFORE="$(mktemp)"
for key in ID ID_LIKE VERSION_ID VERSION VERSION_CODENAME UBUNTU_CODENAME NAME; do
	printf '%s=%s\n' "${key}" \
		"$( ( . /usr/lib/os-release.distrib; eval "printf '%s' \"\${${key}-}\"" ) )" \
		>> "${PROTECTED_BEFORE}"
done

# Read the BRANDED file back, through the symlink an ordinary program would
# use, and check the fields that matter in both directions - the branded ones
# took, and the untouchable ones equal base-files' own. A step whose work is
# not re-read is the shape of every expensive bug in docs/BUILD-NOTES.md.

for pair in "IMAGE_ID=os7" "IMAGE_VERSION=${OS7_VERSION}" "PRETTY_NAME=${OS7_PRODUCT}"; do
	key="${pair%%=*}"; want="${pair#*=}"; got="$(osrel_get "${key}")"
	if [ "${got}" != "${want}" ]; then
		echo "OS/7 hook 0075: /etc/os-release ${key} is '${got}', expected '${want}'" >&2
		exit 1
	fi
done

# The literal contract, for the two fields whose VALUES are the compatibility
# promise rather than merely unchanged.
for pair in "ID=ubuntu" "VERSION_ID=26.04"; do
	key="${pair%%=*}"; want="${pair#*=}"; got="$(osrel_get "${key}")"
	if [ "${got}" != "${want}" ]; then
		echo "OS/7 hook 0075: ${key} is '${got}', expected '${want}' - Intune's" >&2
		echo "OS/7 hook 0075: 'Allowed distributions' rule reads this field." >&2
		exit 1
	fi
done

# NAME, as a GLOB and not as a literal, because the glob IS the contract:
# Install_linux_azcmagent.sh does `case "${distro}" in *buntu*)` and exits 133
# on anything else, having read NAME and never ID (BUILD-NOTES #80). Asserting
# `NAME=Ubuntu` would also pass today and would be asserting the wrong thing.
NAME_GOT="$(osrel_get NAME)"
case "${NAME_GOT}" in
	*buntu*) ;;
	*)
		echo "OS/7 hook 0075: NAME is '${NAME_GOT}', which contains no 'buntu'." >&2
		echo "OS/7 hook 0075: Microsoft's Azure Arc onboarding script reads THIS field," >&2
		echo "OS/7 hook 0075: matches it against *buntu* and exits 133 otherwise - it" >&2
		echo "OS/7 hook 0075: never reads ID at all. BUILD-NOTES #80, IDENTITY-PLAN I2." >&2
		echo "OS/7 hook 0075: The brand belongs in PRETTY_NAME and IMAGE_*, not here." >&2
		exit 1
		;;
esac

# And nothing in the untouchable set moved at all.
while IFS='=' read -r key want; do
	got="$(osrel_get "${key}")"
	if [ "${got}" != "${want}" ]; then
		echo "OS/7 hook 0075: ${key} changed from '${want}' to '${got}'." >&2
		echo "OS/7 hook 0075: that field is somebody else's (IDENTITY-PLAN I4)." >&2
		exit 1
	fi
done < "${PROTECTED_BEFORE}"
rm -f "${PROTECTED_BEFORE}"

# The one field that had to GO. Ubuntu's privacy policy does not describe this
# system, and a stale pointer is worse than none.
if [ -n "$(osrel_get PRIVACY_POLICY_URL)" ]; then
	echo "OS/7 hook 0075: PRIVACY_POLICY_URL is still set; it should have been dropped." >&2
	exit 1
fi

echo "OS/7 hook 0075:   os-release: PRETTY_NAME='${OS7_PRODUCT}', IMAGE_VERSION=${OS7_VERSION}"
echo "OS/7 hook 0075:   os-release: NAME='${NAME_GOT}', ID=ubuntu, VERSION_ID=26.04 - untouched"

# ---------------------------------------------------------------------------
# 1b. The product line, and the two banners that carry it
#     (docs/IDENTITY-PLAN.md §6.1 and §6.2)
#
# /usr/lib/os7/product exists so that NOTHING USER-FACING HAS TO PARSE ANYTHING
# AT RUN TIME. The MOTD header runs at every login; the display rule was already
# applied when this file was written, so that script is three lines of shell and
# starts no interpreter. It is also what makes I1 true in practice: the banner
# reads OS/7's own file, so if PRETTY_NAME ever has to go back to Ubuntu (IL1),
# the login banner does not change.
# ---------------------------------------------------------------------------
install -d -m 0755 /usr/lib/os7
printf '%s\n' "${OS7_PRODUCT}" > /usr/lib/os7/product
chmod 0644 /usr/lib/os7/product

# /etc/issue - the local console, before login. `\n` and `\l` are agetty's
# escapes for the hostname and the tty, and they are LITERAL backslashes in the
# file; the doubled ones below are printf's, not shell's.
printf '%s \\n \\l\n\n' "${OS7_PRODUCT}" > /etc/issue
chmod 0644 /etc/issue

# /etc/issue.net - the ssh banner, shown BEFORE authentication, which makes it a
# different decision rather than the same file with different escapes: it is
# displayed to whoever connects, including whoever should not, so it names the
# product and nothing else. No version, no channel, no kernel.
printf 'OS/7\n' > /etc/issue.net
chmod 0644 /etc/issue.net

for f in /etc/issue /etc/issue.net; do
	if ! grep -q '^OS/7' "${f}"; then
		echo "OS/7 hook 0075: ${f} does not name the product:" >&2
		sed -n '1,3p' "${f}" >&2
		exit 1
	fi
done
# The one that must NOT carry it, checked in the other direction.
if grep -qE '[0-9]+\.[0-9]+' /etc/issue.net; then
	echo "OS/7 hook 0075: /etc/issue.net carries a version; it is shown before login." >&2
	exit 1
fi
echo "OS/7 hook 0075:   /usr/lib/os7/product, /etc/issue and /etc/issue.net written"

# ---------------------------------------------------------------------------
# 1c. The MOTD (docs/IDENTITY-PLAN.md §6.1, decision I9)
#
# Today an ssh login opens with "Welcome to Ubuntu 26.04 LTS", Ubuntu
# documentation links, and - depending on what the package lists pulled in -
# 50-motd-news, which makes a NETWORK REQUEST to motd.ubuntu.com at login, plus
# Ubuntu Pro and ESM announcements. On a Microsoft-administered corporate fleet
# the news fetch is a privacy and latency problem before it is a branding one.
#
# DISABLED, NOT DELETED. `dpkg` restores a file it owns on the next apt run,
# silently; `chmod a-x` is what run-parts honours and what survives.
#
# A KEEP-LIST, NOT A DENY-LIST, and it is a decision: nothing appears at login
# that OS/7 did not put there, except the reboot notice - which is real,
# product-neutral information an administrator wants. A deny-list would let the
# next drop-in Ubuntu adds appear on every OS/7 machine unannounced.
#
# WHAT IS ACTUALLY IN THIS DIRECTORY HAS NEVER BEEN MEASURED (IDENTITY-PLAN
# IL10), so nothing here names a file it expects to find. It enumerates, acts,
# and prints what it did - and installer/testing/check-image.py reads the result
# off the finished artefact.
# ---------------------------------------------------------------------------
MOTD_DIR=/etc/update-motd.d
OS7_MOTD="${MOTD_DIR}/00-os7-header"

if [ ! -s "${OS7_MOTD}" ]; then
	echo "OS/7 hook 0075: ${OS7_MOTD} is missing or empty (includes.chroot)" >&2
	exit 1
fi
# It ships 0644 from includes.chroot - a git checkout on a filesystem with no
# executable bit is the normal case here, so the mode is set rather than
# assumed (the same trade hook 0090 makes for the backup scripts).
chmod 0755 "${OS7_MOTD}"

disabled=""
kept=""
for f in "${MOTD_DIR}"/*; do
	[ -f "${f}" ] || continue
	name="$(basename "${f}")"
	case "${name}" in
		00-os7-header)
			continue ;;
		# The reboot notice: not Ubuntu branding, not an advertisement, and the
		# one thing in that directory an operator would miss.
		98-reboot-required)
			[ -x "${f}" ] && kept="${kept} ${name}"
			continue ;;
	esac
	if [ -x "${f}" ]; then
		chmod a-x "${f}"
		disabled="${disabled} ${name}"
	fi
done

# motd-news also has an off switch of its own, and turning it off is worth doing
# in addition to removing the executable bit: the two are independent, and the
# package's postinst can restore the bit.
if [ -f /etc/default/motd-news ]; then
	sed -i -E 's/^[[:space:]]*ENABLED=.*/ENABLED=0/' /etc/default/motd-news
	if ! grep -q '^ENABLED=0' /etc/default/motd-news; then
		echo "OS/7 hook 0075: could not disable motd-news in /etc/default/motd-news" >&2
		exit 1
	fi
	echo "OS/7 hook 0075:   /etc/default/motd-news: ENABLED=0 (no login-time fetch)"
fi

# Read the directory back rather than trusting the loop above.
still="$(find "${MOTD_DIR}" -maxdepth 1 -type f -perm -u+x -printf '%f ' 2>/dev/null || true)"
echo "OS/7 hook 0075:   MOTD: disabled ->${disabled:- (none)}"
echo "OS/7 hook 0075:   MOTD: still executable -> ${still:-(none)}${kept:+ (kept:${kept} )}"
case " ${still} " in
	*" 00-os7-header "*) ;;
	*)
		echo "OS/7 hook 0075: 00-os7-header is not executable after chmod." >&2
		exit 1
		;;
esac

# The mechanism that displays any of this. If no PAM stack references pam_motd,
# nothing in that directory is ever run - and that is a NOTE rather than a
# failure, because it depends on which login packages the image carries and the
# hook cannot tell "not installed" from "misconfigured" (BUILD-NOTES #38).
if grep -rqs 'pam_motd' /etc/pam.d/; then
	echo "OS/7 hook 0075:   MOTD: pam_motd is wired up in /etc/pam.d"
else
	echo "OS/7 hook 0075:   NOTE: no /etc/pam.d file references pam_motd, so the MOTD"
	echo "OS/7 hook 0075:   NOTE: may never be displayed on this image. Not fatal here;"
	echo "OS/7 hook 0075:   NOTE: check-image.py reads the artefact and run-phase*.py a boot."
fi

# ---------------------------------------------------------------------------
# 2. The package manifest.
#
# §3.4 specifies `dpkg --get-selections`. THIS WRITES VERSIONS AS WELL, and the
# difference is not cosmetic: selections record package NAMES and an install
# state, so two systems holding linux-image 7.0.0-28 and 7.0.0-31 produce
# byte-identical selections. §5 exists to catch exactly that - an admin typing
# `apt upgrade` behind the release train's back - and against selections alone
# the check cannot see it.
#
# So the manifest is `package<TAB>version<TAB>architecture`, sorted. It is a
# strict superset of the selections list, and it makes both things the plan
# wants it for actually work: drift detection (§5) and comparing two builds of
# the same release (spike S7).
# ---------------------------------------------------------------------------
MANIFEST=/usr/lib/os7/packages.manifest
dpkg-query -W -f='${binary:Package}\t${Version}\t${Architecture}\n' \
	| LC_ALL=C sort > "${MANIFEST}"
chmod 0644 "${MANIFEST}"
MANIFEST_SHA="$(sha256sum "${MANIFEST}" | cut -d' ' -f1)"
echo "OS/7 hook 0075:   ${MANIFEST}: $(wc -l < "${MANIFEST}") packages, sha256 ${MANIFEST_SHA:0:16}…"

# ---------------------------------------------------------------------------
# 3. The bill of materials.
#
# Everything here is MEASURED from the image except the three things that
# cannot be: the version and git provenance (build.conf), the archive snapshot
# (release.conf), and the .NET SDK (not in the image - os7-setup is NativeAOT).
#
# Where a pinned value and a measured value both exist, BOTH are recorded. A pin
# says what was asked for and a measurement says what arrived; collapsing them
# into one field would throw away the only evidence that they agreed.
# ---------------------------------------------------------------------------
pkgver() { dpkg-query -W -f='${Version}' "$1" 2>/dev/null || true; }

# The kernel by the name `uname -r` will report, taken from the artefact rather
# than from a meta-package version - linux-image-generic's version and the kernel
# ABI string are different things and only one of them appears in a bug report.
#
# Reading the artefact is also what keeps this correct across BUILD-NOTES #62,
# where which meta-package installs the kernel turned out to be decided by
# live-build's mode rather than by the package list.
KERNEL_RELEASE="$(ls -1 /boot/vmlinuz-* 2>/dev/null | LC_ALL=C sort -V | tail -n1 | sed 's|.*/vmlinuz-||')"
[ -n "${KERNEL_RELEASE}" ] || {
	echo "OS/7 hook 0075: no kernel in /boot - the image cannot boot" >&2
	exit 1
}

ZFS_VERSION="$(pkgver zfsutils-linux)"
AUTHD_VERSION="$(pkgver authd)"
# The backup engine (docs/BACKUP-PLAN.md). It comes from the archive, so the
# snapshot pin already decides which version arrives - and it is recorded
# because it is the one third-party program OS/7 lets run unattended against its
# pools, which is a thing a support case asks about by version.
SANOID_VERSION="$(pkgver sanoid)"
AZCMAGENT_VERSION="$(pkgver azcmagent)"
INTUNE_VERSION="$(pkgver intune-portal)"

# The PowerShell hash the pin asserted for THIS architecture. Recorded rather
# than re-computed: the tarball is gone by now, and what matters in the manifest
# is which hash the build verified against, not a hash of the unpacked tree.
case "${ARCH}" in
	amd64) PWSH_SHA="${OS7_PWSH_SHA256_x64}"   ;;
	arm64) PWSH_SHA="${OS7_PWSH_SHA256_arm64}" ;;
	*)     PWSH_SHA=""                          ;;
esac

SETUP_BIN=/usr/lib/os7-setup/os7-setup
SETUP_SHA="$(sha256sum "${SETUP_BIN}" 2>/dev/null | cut -d' ' -f1 || true)"

MODULE_PSD1=/usr/local/share/powershell/Modules/OS7/OS7.psd1
MODULE_VERSION="$(sed -n "s/.*ModuleVersion[[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" "${MODULE_PSD1}" 2>/dev/null | head -n1)"
if [ "${MODULE_VERSION}" != "${OS7_VERSION}" ]; then
	echo "OS/7 hook 0075: OS7 module is ${MODULE_VERSION:-<unset>}, product is ${OS7_VERSION}" >&2
	echo "OS/7 hook 0075: build-os7-packages.sh stamps the .psd1 - it did not take." >&2
	exit 1
fi

# PowerShell: the pin says 7.6.5, the binary is asked what it thinks it is.
# `pwsh --version` is not a health check (BUILD-NOTES: the banner is compiled
# into the binary and succeeds while the module tree is unusable) but
# it is a perfectly good VERSION check, which is all it is used for here.
PWSH_MEASURED="$(/usr/bin/pwsh --version 2>/dev/null | sed 's/^PowerShell //' || true)"
if [ -n "${PWSH_MEASURED}" ] && [ "${PWSH_MEASURED}" != "${OS7_PWSH_VERSION}" ]; then
	echo "OS/7 hook 0075: PowerShell reports ${PWSH_MEASURED}, pin says ${OS7_PWSH_VERSION}" >&2
	exit 1
fi

# The DECLARED release facts are os7-release's file; assert it is there, owned,
# and names this build before measuring anything beside it.
DECLARED_JSON=/usr/lib/os7/release.json
if ! dpkg -S "${DECLARED_JSON}" 2>/dev/null | grep -q '^os7-release:'; then
	echo "OS/7 hook 0075: ${DECLARED_JSON} is not owned by os7-release (hook 0022)" >&2
	exit 1
fi
DECLARED_VERSION="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "${DECLARED_JSON}")"
if [ "${DECLARED_VERSION}" != "${OS7_VERSION}" ]; then
	echo "OS/7 hook 0075: os7-release declares ${DECLARED_VERSION}, this build is ${OS7_VERSION}" >&2
	exit 1
fi

RELEASE_JSON=/usr/lib/os7/image.json
export KERNEL_RELEASE ZFS_VERSION AUTHD_VERSION AZCMAGENT_VERSION INTUNE_VERSION SANOID_VERSION
export PWSH_SHA SETUP_SHA MODULE_VERSION MANIFEST_SHA

python3 - "${RELEASE_JSON}" <<'PY'
import json, os, sys

env = os.environ
def v(name):
    """A dpkg version that came back empty means the package is not installed."""
    return env.get(name) or None

dirty = env["OS7_GIT_DIRTY"] == "true"

doc = {
    "version":      env["OS7_VERSION"],
    "channel":      env["OS7_CHANNEL"],
    "built":        env["OS7_BUILT"],
    "architecture": env["OS7_BUILD_ARCH"],

    # Whether this build can be reproduced from the recorded inputs alone.
    # False when the source tree was dirty: the archive is pinned, but the OS/7
    # half of the product then came from a state no commit names. Recorded
    # rather than warned about once, because the warning scrolls past and the
    # ISO outlives it.
    "reproducible": not dirty,
    "source": {
        "commit": env["OS7_GIT_COMMIT"],
        "dirty":  dirty,
    },

    "base": {
        "distribution":     "ubuntu",
        "release":          env["OS7_UBUNTU_RELEASE"],
        "codename":         env["OS7_DISTRIBUTION"],
        "archive_snapshot": env["OS7_ARCHIVE_SNAPSHOT"],
        "archive_base":     env["OS7_ARCHIVE_BASE"],
    },

    "components": {
        "kernel":     env["KERNEL_RELEASE"],
        "zfs":        v("ZFS_VERSION"),
        "powershell": {
            "version": env["OS7_PWSH_VERSION"],
            "sha256":  env["PWSH_SHA"],
        },
        # Not in the image to measure - os7-setup is NativeAOT and the image
        # ships no .NET runtime (spike S2). This is the SDK that COMPILED it.
        # From build.conf — since the switch to packages, the os7-release
        # package's own copy, which records the SDK that compiled os7-setup
        # in the SAME builder run. "unknown" is a fact about an old
        # build.conf, not a default to hide behind; one build died on the
        # strict form when the two build.confs traded places under dpkg.
        "dotnet_sdk": env.get("OS7_DOTNET_SDK") or "unknown",
        "os7_setup":  {
            "version": env["OS7_VERSION"],
            "sha256":  env["SETUP_SHA"] or None,
        },
        "os7_module": env["MODULE_VERSION"],
        "authd":      v("AUTHD_VERSION"),
        # docs/DECISIONS.md open question 4: authd-msentraid is a Canonical snap and
        # seeding a snap into a live-build image is unsolved. Recorded as absent
        # WITH ITS REASON, because a null here otherwise reads as an oversight
        # and this is a known, headline gap.
        "authd_msentraid": {
            "present": False,
            "reason": "snap seeding into live-build is unsolved; see docs/DECISIONS.md open question 4",
        },
        # The backup engine (docs/BACKUP-PLAN.md). BOTH values, per this file's
        # own rule: the pin says what was asked for and dpkg says what arrived,
        # and hook 0090 fails the build when they disagree. sanoid is
        # Architecture: all, so this is the same on both products.
        "sanoid": {
            "pinned":    env.get("OS7_SANOID_VERSION") or None,
            "installed": v("SANOID_VERSION"),
            "licence":   "GPL-3.0+, run as a program and not vendored",
        },
    },

    "microsoft": {
        "azcmagent":     v("AZCMAGENT_VERSION"),
        "intune_portal": v("INTUNE_VERSION"),
    },

    "packages_manifest": "sha256:" + env["MANIFEST_SHA"],
}

with open(sys.argv[1], "w", encoding="utf-8") as fh:
    json.dump(doc, fh, indent=2, sort_keys=False)
    fh.write("\n")
PY

chmod 0644 "${RELEASE_JSON}"

# Read it back and check the one field everything downstream depends on. The
# boot-environment name, the GRUB menu title and Setup's title bar are all
# derived from this file; a release.json that parses and holds the wrong version
# would put a wrong number in all three without failing anything.
GOT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "${RELEASE_JSON}")"
if [ "${GOT}" != "${OS7_VERSION}" ]; then
	echo "OS/7 hook 0075: ${RELEASE_JSON} says version ${GOT}, expected ${OS7_VERSION}" >&2
	exit 1
fi

# The module is what actually composes boot-environment names (SETUP-PLAN §6.3),
# and it reads this file. Asking IT is the check that matters, because a
# manifest the module cannot use is a manifest that does not exist as far as the
# installed system is concerned.
#
# Import BY PATH: PowerShell's module discovery is broken under chroot(2)
# (BUILD-NOTES #14), so Import-Module by NAME cannot work here and its failure
# would look like a broken manifest.
# Establish that the interpreter and the module are THERE before asking them
# anything. Without this, a missing pwsh and a module that ignores the manifest
# produce the same empty string, and the error below would confidently name the
# wrong cause - which is the failure mode BUILD-NOTES keeps recording.
[ -x /usr/bin/pwsh ] || {
	echo "OS/7 hook 0075: /usr/bin/pwsh is missing - hook 0022 should have installed os7-powershell." >&2
	exit 1
}
[ -f "${MODULE_PSD1}" ] || {
	echo "OS/7 hook 0075: ${MODULE_PSD1} is missing - hook 0022 should have installed os7-module." >&2
	exit 1
}

# Keep the WHOLE transcript, not just the last line. The first attempt kept
# `tail -n1` and the note it printed read "…verify that the path is correct and
# try again" - the tail of PowerShell's command-not-found message, with the
# sentence naming the command scrolled off. That sent the next reader after an
# import problem that was not there (BUILD-NOTES #38). ANSI is stripped because
# pwsh colours its errors and the escapes land in the build log.
BE_OUT="$(/usr/bin/pwsh -NoLogo -NoProfile -Command \
	"Import-Module '${MODULE_PSD1}' -Force; New-OS7BootEnvironmentName" 2>&1 \
	| tr -d '\r' | sed -e 's/\x1b\[[0-9;]*m//g' || true)"
BE_NAME="$(printf '%s\n' "${BE_OUT}" | grep -E '^os7_' | tail -n1 || true)"

# THREE OUTCOMES, NOT TWO, and the middle one is why this is not a plain
# assertion (BUILD-NOTES #38).
#
#   the right name    the whole chain works: manifest -> module -> BE name.
#   the WRONG name    fatal. The module ran and answered with a version that is
#                     not this release, so every install would create a dataset
#                     named after the wrong one.
#   NO name           a NOTE, not a failure. PowerShell under chroot(2) has a
#                     documented history of failing for reasons that have
#                     nothing to do with the manifest (#14, #20's RNG problem),
#                     and a build-time convenience must not be able to fail an
#                     ISO over a build-time limitation.
#
# Collapsing "cannot tell" into "wrong" would make this hook report a broken
# image for a working one. The load-bearing check that the version reaches the
# DISK is installer/testing/run-phase2.py, on a booted system.
case "${BE_NAME}" in
	os7_${OS7_VERSION}_*)
		echo "OS/7 hook 0075:   boot environments will be named ${BE_NAME}"
		;;
	os7_*_*)
		echo "OS/7 hook 0075: New-OS7BootEnvironmentName returned '${BE_NAME}'," >&2
		echo "OS/7 hook 0075: expected os7_${OS7_VERSION}_<stamp>. The module ran and" >&2
		echo "OS/7 hook 0075: answered with a DIFFERENT version, so it is not reading" >&2
		echo "OS/7 hook 0075: ${RELEASE_JSON} - every install would name its boot" >&2
		echo "OS/7 hook 0075: environment after the wrong release." >&2
		echo "OS/7 hook 0075: The manifest reads:" >&2
		sed -n '1,4p' "${RELEASE_JSON}" >&2
		exit 1
		;;
	*)
		echo "OS/7 hook 0075:   NOTE: the module produced no boot-environment name."
		echo "OS/7 hook 0075:   NOTE: this is EXPECTED at build time - hook 0060 can import"
		echo "OS/7 hook 0075:   NOTE: the module by path and list its functions, but CALLING"
		echo "OS/7 hook 0075:   NOTE: one fails: New-OS7BootEnvironmentName needs Get-Content"
		echo "OS/7 hook 0075:   NOTE: and ConvertFrom-Json, which have to be autoloaded by"
		echo "OS/7 hook 0075:   NOTE: name out of \$PSHOME/Modules - the lookup #14 mangles."
		echo "OS/7 hook 0075:   NOTE: BUILD-NOTES #38 has the whole distinction."
		echo "OS/7 hook 0075:   NOTE: pwsh said, in full:"
		printf '%s\n' "${BE_OUT:-<nothing>}" | sed 's/^/OS\/7 hook 0075:   NOTE:   | /'
		echo "OS/7 hook 0075:   NOTE: The manifest itself is verified above. That the version"
		echo "OS/7 hook 0075:   NOTE: reaches the DISK is checked by run-phase2.py on a booted"
		echo "OS/7 hook 0075:   NOTE: system, which is where it counts and where this works."
		;;
esac

echo "OS/7 hook 0075: done"
