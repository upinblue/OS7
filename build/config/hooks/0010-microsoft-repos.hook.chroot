#!/bin/bash
# OS/7 — add the Microsoft APT repositories.
#
# Runs INSIDE the chroot, after the package-list pass. Anything that comes from
# a Microsoft repo must be installed by a later hook, never by a package list,
# because the repos do not exist yet when the lists are processed.
# (docs/BUILD-NOTES.md #10)
#
# TWO SIGNING KEYS ARE REQUIRED. Microsoft rotated keys in spring 2025:
#
#   microsoft.asc       EB3E94ADBE1229CF  old key, contains SHA1 signatures.
#                                         Still signs pre-existing repos.
#   microsoft-2025.asc  EE4D7792F748182B  current key, SHA1-free. Signs repos
#                                         created since.
#
# Verified against the live repos on 2026-08-22:
#   ubuntu/26.04/prod  resolute  ->  EE4D7792F748182B  (new repo, 2025 key)
#   repos/edge         stable    ->  EB3E94ADBE1229CF  (old repo, legacy key)
#   repos/azure-cli    noble     ->  EB3E94ADBE1229CF  (old repo, legacy key)
#
# Using only microsoft.asc - the obvious choice, and what most documentation
# still shows - fails the resolute repo with "is not signed".
#
# Keys are scoped per-repo via Signed-By rather than dumped into one keyring, so
# neither key can authenticate a repo it does not actually sign.

#
# The two fingerprints are pinned in build/config/os7-release.conf, with every
# other component version and hash the release fixes.

set -euo pipefail

[ -r /usr/lib/os7/release.conf ] || {
	echo "OS/7 hook 0010: /usr/lib/os7/release.conf missing - build.sh did not stage the pin" >&2
	exit 1
}
# shellcheck source=/dev/null
. /usr/lib/os7/release.conf

ARCH="$(dpkg --print-architecture)"
echo "OS/7 hook 0010: adding Microsoft repositories (arch=${ARCH})"

install -d -m 0755 /usr/share/keyrings /etc/apt/sources.list.d

# Fetch a key, dearmor it, and ASSERT its fingerprint. Pinning here means a
# future key rotation fails the build loudly instead of silently trusting
# whatever is served.
fetch_key() {
	local name="$1" dest="$2" want_fpr="$3"
	curl -fsSL --retry 5 --retry-delay 3 --retry-connrefused --retry-all-errors \
		"https://packages.microsoft.com/keys/${name}" | gpg --dearmor -o "${dest}"
	chmod 0644 "${dest}"
	local got_fpr
	got_fpr="$(gpg --show-keys --with-colons "${dest}" 2>/dev/null | awk -F: '/^fpr:/{print $10; exit}')"
	if [ "${got_fpr}" != "${want_fpr}" ]; then
		echo "OS/7 hook 0010: FINGERPRINT MISMATCH for ${name}" >&2
		echo "OS/7 hook 0010:   expected ${want_fpr}" >&2
		echo "OS/7 hook 0010:   got      ${got_fpr}" >&2
		exit 1
	fi
	echo "OS/7 hook 0010:   ${name} -> ${dest} (${got_fpr})"
}

fetch_key microsoft-2025.asc /usr/share/keyrings/microsoft-2025.gpg \
	"${OS7_MSKEY_2025_FPR}"
fetch_key microsoft.asc      /usr/share/keyrings/microsoft-legacy.gpg \
	"${OS7_MSKEY_LEGACY_FPR}"

# --- prod/resolute: azcmagent (both arches), intune-portal + identity broker
# --- (amd64 only). Native 26.04 suite - no cross-release pinning needed.
cat > /etc/apt/sources.list.d/microsoft-prod.sources <<SRC
Types: deb
URIs: https://packages.microsoft.com/ubuntu/26.04/prod
Suites: resolute
Components: main
Architectures: ${ARCH}
Signed-By: /usr/share/keyrings/microsoft-2025.gpg
SRC

# --- Azure CLI. Published against the noble suite only; it is arch-independent
# --- Python tooling and is available for amd64 and arm64 alike.
cat > /etc/apt/sources.list.d/microsoft-azure-cli.sources <<SRC
Types: deb
URIs: https://packages.microsoft.com/repos/azure-cli
Suites: noble
Components: main
Architectures: ${ARCH}
Signed-By: /usr/share/keyrings/microsoft-legacy.gpg
SRC

# --- Microsoft Edge. amd64 ONLY, for two independent reasons: arm64 is a
# --- SERVER-ONLY target with no GUI, and Microsoft builds no arm64 Linux Edge
# --- anyway. Adding the repo on arm64 would only produce apt noise.
if [ "${ARCH}" = "amd64" ]; then
	cat > /etc/apt/sources.list.d/microsoft-edge.sources <<SRC
Types: deb
URIs: https://packages.microsoft.com/repos/edge
Suites: stable
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/microsoft-legacy.gpg
SRC
else
	echo "OS/7 hook 0010: skipping the Edge repo - ${ARCH} is a server-only target (no GUI)."
fi

apt-get update
echo "OS/7 hook 0010: done"
