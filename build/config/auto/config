#!/bin/sh
# =============================================================================
# OS/7 — live-build configuration
#
# The flag choices below are not arbitrary: several are HARVESTED FROM A PRIOR
# BUILD SESSION (2026-06-24) that reached a bootable arm64 ISO. Each harvested
# flag is marked. See docs/BUILD-NOTES.md before changing one.
#
# Invoked by `lb config` from the staged build root (see build/build.sh).
# Must remain executable.
# =============================================================================

set -e

# --- The release pin ---------------------------------------------------------
# Everything this build IS comes from one file. build.sh stages it next to this
# script; `make lb-config` copies the same directory, so both paths find it.
#
# A missing pin file is fatal rather than defaulted: a build that quietly fell
# back to the live archive would produce an ISO that looks identical to a pinned
# one and is not reproducible, which is precisely the failure the pin exists to
# prevent.
OS7_RELEASE_CONF="${OS7_RELEASE_CONF:-auto/os7-release.conf}"
if [ ! -r "${OS7_RELEASE_CONF}" ]; then
	echo "OS/7: release pin not found at ${OS7_RELEASE_CONF}" >&2
	echo "OS/7: refusing to build against an unpinned archive." >&2
	exit 1
fi
. "${OS7_RELEASE_CONF}"

# --- Build-time knobs --------------------------------------------------------
# Set by build/build.sh from the make target.
OS7_ARCH="${OS7_ARCH:-amd64}"

case "${OS7_ARCH}" in
	amd64|arm64) ;;
	*)
		echo "OS/7: unsupported architecture '${OS7_ARCH}' (expected amd64 or arm64)" >&2
		exit 1
		;;
esac

# The four-field product version. Computed by build.sh, because its BUILD field
# comes from `git rev-list --count HEAD` and this script runs from a staged tree
# that is not a git repository. Not defaulted here for the same reason the pin
# file is not: an ISO labelled with a version nobody chose is worse than a
# failed build.
if [ -z "${OS7_VERSION:-}" ]; then
	echo "OS/7: OS7_VERSION is not set - build.sh must export it." >&2
	exit 1
fi

# --- The archive -------------------------------------------------------------
# ONE URL for both architectures.
#
# Ubuntu's live archive splits by architecture - amd64 on archive.ubuntu.com,
# every port (incl. arm64) on ports.ubuntu.com - and this file used to branch on
# that. The snapshot service does NOT: arm64 is served under the same /ubuntu/
# path, measured 2026-08-24 (os7-release.conf records the checks). So pinning the
# archive REMOVES a per-architecture special case rather than adding one.
OS7_MIRROR="${OS7_ARCHIVE_BASE}/${OS7_ARCHIVE_SNAPSHOT}/"

# EVERY mirror flag, in both families. Not the three obvious ones.
#
# Setting only --mirror-bootstrap/chroot/binary is the obvious mistake and it is
# silent. live-build defaults the ones you did not name, and its defaults are
# live archives: the build then draws its base from a pinned snapshot and its
# updates and security from whatever is current, and the resulting ISO is
# unreproducible while every flag on screen says it is pinned.
#
# MEASURED, not reasoned about. `lb config` was run and its config/bootstrap read
# back, which is the only way to see what live-build actually recorded:
#
#   naming bootstrap/chroot/chroot-security/binary/binary-security still left
#   LB_MIRROR_CHROOT_VOLATILE and LB_MIRROR_BINARY_VOLATILE pointing at
#   http://archive.ubuntu.com/ubuntu/ - live, and on arm64 not even the right
#   host, since ports live on ports.ubuntu.com.
#
# "Volatile" is Debian's name for what Ubuntu calls -updates. So the two flags
# that were missing were the ones covering the suite that MOVES.
#
# The snapshot service carries resolute, resolute-updates and resolute-security
# under one base URL (measured 200 for all three), so there is nowhere else any
# of these could legitimately point.
#
# `--mode ubuntu` makes ubuntu the parent distribution, so the parent family is
# what actually reaches debootstrap; the non-parent family is set to match so
# that no code path can pick up a different archive. Backports stay "none".
lb config noauto \
	--mode ubuntu \
	--distribution "${OS7_DISTRIBUTION}" \
	--architectures "${OS7_ARCH}" \
	--parent-mirror-bootstrap "${OS7_MIRROR}" \
	--parent-mirror-chroot "${OS7_MIRROR}" \
	--parent-mirror-chroot-security "${OS7_MIRROR}" \
	--parent-mirror-chroot-volatile "${OS7_MIRROR}" \
	--parent-mirror-binary "${OS7_MIRROR}" \
	--parent-mirror-binary-security "${OS7_MIRROR}" \
	--parent-mirror-binary-volatile "${OS7_MIRROR}" \
	--mirror-bootstrap "${OS7_MIRROR}" \
	--mirror-chroot "${OS7_MIRROR}" \
	--mirror-chroot-security "${OS7_MIRROR}" \
	--mirror-chroot-volatile "${OS7_MIRROR}" \
	--mirror-binary "${OS7_MIRROR}" \
	--mirror-binary-security "${OS7_MIRROR}" \
	--mirror-binary-volatile "${OS7_MIRROR}" \
	--archive-areas "main restricted universe multiverse" \
	`# HARVESTED FIX 4: "none" is REJECTED by this live-build ("flavour none` \
	`# not supported"). "false" is the value that actually disables it.` \
	--debian-installer false \
	`# amd64 ONLY, and loaded by default: lb_binary_memtest copies` \
	`# chroot/boot/${_MEMTEST_BIN}.bin from a variable nothing assigns unless` \
	`# memtest86+x64.bin is already in the chroot - so it runs cp chroot/boot/.bin` \
	`# and the build dies at the binary stage. BUILD-NOTES #44; it is what stopped` \
	`# the only native-x86_64 amd64 attempt this project has evidence of. arm64` \
	`# skips the whole stage (x86-only), which is why no ISO built here has met` \
	`# it. "none" and "false" both reach the early exit - unlike` \
	`# --debian-installer above, where "none" is rejected. OS/7 wants nothing` \
	`# from this stage: the medium carries exactly two GRUB entries by design.` \
	`# UNPROVEN: that an amd64 ISO now builds. This removes the next failure,` \
	`# not demonstrably the last one.` \
	--memtest none \
	`# amd64 ONLY, and a STOPGAP. lb_binary_syslinux's Ubuntu branch installs` \
	`# syslinux-themes-${LB_SYSLINUX_THEME} AND gfxboot-theme-ubuntu; the default` \
	`# theme name is "ubuntu-oneiric", a package last seen in Ubuntu 11.10, and` \
	`# neither exists in resolute - so the stage dies with "Unable to locate` \
	`# package syslinux-themes-ubuntu-oneiric". BUILD-NOTES #47. The literal` \
	`# value "live-build" takes a different branch that needs only librsvg2-bin.` \
	`# WHY THIS IS A STOPGAP: syslinux is a BIOS bootloader, and OS/7 boots UEFI` \
	`# with shim and a Canonical-signed GRUB (README, locked decisions). This` \
	`# live-build has NO grub-efi stage at all - grub, grub2, syslinux, yaboot,` \
	`# silo - which is the same hole arm64-efi-remaster.sh already fills on arm64.` \
	`# The amd64 medium needs that treatment too; this flag only stops the build` \
	`# from dying before there is anything to treat.` \
	--syslinux-theme live-build \
	`# THE DECISION UNDER THE FLAG ABOVE: amd64 stops running live-build's` \
	`# bootloader stages at all, because arm64 already does not run them and OS/7` \
	`# owns its medium's boot path either way. Measured: LB_BOOTLOADER defaults to` \
	`# "syslinux" on amd64 and to "" (EMPTY) on arm64 - which is the whole reason` \
	`# build/lib/arm64-efi-remaster.sh exists. Every bootloader stage guards on` \
	`# [ "${LB_BOOTLOADER}" != "<its own name>" ] and lb_binary_iso's case has no` \
	`# branch for an unknown value, so "none" is inert on BOTH arches and puts` \
	`# amd64 in exactly the position arm64 has been in since the first build.` \
	`# syslinux is BIOS and OS/7 boots UEFI (README, locked decisions), so nothing` \
	`# that stage produces was ever going to ship. BUILD-NOTES #47.` \
	`# WHAT THIS COSTS: live-build now emits an ISO with no El Torito entry on` \
	`# amd64 - contents without a boot path, which check-image.py can still read` \
	`# in full. Making it boot is an amd64 EFI remaster, and it is not written.` \
	--bootloader none \
	`# Same shape, one stage later, and found the same way. lb_binary_iso writes` \
	`# a binary.sh and appends "isohybrid ${IMAGE}" when LB_BINARY_IMAGES is` \
	`# "iso-hybrid" - and isohybrid ships in syslinux-UTILS while live-build` \
	`# installs syslinux, so the command is absent and the whole build exits 127.` \
	`# Measured defaults: amd64 "iso-hybrid", arm64 "iso". Again the BIOS-flavoured` \
	`# default on amd64 and the plain one on arm64; isohybrid writes an MBR so a` \
	`# stick boots legacy BIOS, which a UEFI product does not want and a` \
	`# re-mastered medium would discard anyway. BUILD-NOTES #47.` \
	--binary-images iso \
	`# HARVESTED FIX 5: Ubuntu-mode live-build expects the casper initramfs at` \
	`# binary/casper/initrd.img; without boot=casper (and the casper package in` \
	`# the base list) lb_binary_disk fails.` \
	--bootappend-live "boot=casper quiet splash" \
	--iso-application "OS/7" \
	--iso-publisher "up in blue GmbH; https://github.com/upinblue/OS7" \
	`# The version is ON the medium, not only in it. A mounted ISO, a USB stick` \
	`# in a drawer and a support ticket all quote the volume name.` \
	--iso-volume "OS7-${OS7_VERSION}-${OS7_ARCH}" \
	"${@}"

# NOTE: deliberately NOT setting --bootloaders / --binary-images here. The prior
# session used live-build's defaults and found that on arm64 live-build emits no
# bootloader at all (lb_binary_grub2 is gated to amd64 i386) — which is why
# build/lib/arm64-efi-remaster.sh exists. Adding --bootloaders does not fix that.
