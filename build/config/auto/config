#!/bin/sh
# =============================================================================
# OS/7 — live-build configuration
#
#   *** STUB — no package lists, hooks or includes.chroot authored yet. ***
#
# The flag choices below are not arbitrary: several are HARVESTED FROM A PRIOR
# BUILD SESSION (2026-06-24) that reached a bootable arm64 ISO. Each harvested
# flag is marked. See docs/BUILD-NOTES.md before changing one.
#
# Invoked by `lb config` from the staged build root (see build/build.sh).
# Must remain executable.
# =============================================================================

set -e

# --- Locked ------------------------------------------------------------------
# Ubuntu 26.04 LTS "Resolute Raccoon". Not overridable (README "Locked decisions").
OS7_DISTRIBUTION="resolute"

# --- Build-time knobs --------------------------------------------------------
# Set by build/build.sh from the make target.
OS7_ARCH="${OS7_ARCH:-amd64}"

# Ubuntu splits its archive by architecture: amd64 lives on archive.ubuntu.com,
# every other port (incl. arm64) lives on ports.ubuntu.com. Wrong mirror =
# failure at debootstrap time.
#
# NOTE: this is NOT harvested — the prior session set no mirror flags at all and
# still built arm64, so live-build's ubuntu mode may already handle the split.
# Being explicit is safer, but if `lb config` complains, this is a prime suspect.
case "${OS7_ARCH}" in
	amd64)
		OS7_MIRROR="http://archive.ubuntu.com/ubuntu/"
		;;
	arm64)
		OS7_MIRROR="http://ports.ubuntu.com/ubuntu-ports/"
		;;
	*)
		echo "OS/7: unsupported architecture '${OS7_ARCH}' (expected amd64 or arm64)" >&2
		exit 1
		;;
esac

# =============================================================================
# STUB: a build from this config produces (at best) a bare Ubuntu live system
# with none of OS/7 in it:
#   - no PowerShell 7 / .NET            (README: Core, non-negotiable)
#   - no authd + authd-msentraid        (README: Identity)
#   - no ZFS root support               (README: Storage - blocked on Open Q #1)
#   - no os7-setup installer            (installer/SETUP-PLAN.md - the hard part)
#   - no GNOME / headless mode split    (README: installer-time choice)
# =============================================================================

lb config noauto \
	--mode ubuntu \
	--distribution "${OS7_DISTRIBUTION}" \
	--architectures "${OS7_ARCH}" \
	--mirror-bootstrap "${OS7_MIRROR}" \
	--mirror-chroot "${OS7_MIRROR}" \
	--mirror-binary "${OS7_MIRROR}" \
	--archive-areas "main restricted universe multiverse" \
	`# HARVESTED FIX 4: "none" is REJECTED by this live-build ("flavour none` \
	`# not supported"). "false" is the value that actually disables it.` \
	--debian-installer false \
	`# HARVESTED FIX 5: Ubuntu-mode live-build expects the casper initramfs at` \
	`# binary/casper/initrd.img; without boot=casper (and the casper package in` \
	`# the base list) lb_binary_disk fails.` \
	--bootappend-live "boot=casper quiet splash" \
	--iso-application "OS/7" \
	--iso-publisher "up in blue GmbH; https://github.com/upinblue/OS7" \
	--iso-volume "OS7-${OS7_ARCH}" \
	"${@}"

# NOTE: deliberately NOT setting --bootloaders / --binary-images here. The prior
# session used live-build's defaults and found that on arm64 live-build emits no
# bootloader at all (lb_binary_grub2 is gated to amd64 i386) — which is why
# build/lib/arm64-efi-remaster.sh exists. Adding --bootloaders does not fix that.
