# OS/7 desktop (GNOME) — amd64 only.
#
# GNOME is here because GUI mode REQUIRES it: supported Microsoft Intune
# enrollment needs GNOME (README, "Identity"). arm64 is server-only and gets no
# desktop list at all.
#
# It ships in the live image so the installer can lay it down OFFLINE when the
# operator picks GUI mode; headless is then a package-removal step, per README's
# one-shared-package-base-per-architecture rule.
#
# NOTE: the desktop is NOT here for the installer's benefit. os7-setup is a
# keyboard-driven TEXT-MODE installer (installer/SETUP-PLAN.md) and needs no
# desktop session - that is precisely why it replaced Calamares, which as a Qt
# GUI app could never have installed the desktop-less arm64 image.
#
# IMPORTANT: live-build package lists do NOT support trailing inline comments.
# Every token on a non-comment line is passed to apt as a package name.
# (docs/BUILD-NOTES.md #9)
#
# NOTE: no Microsoft packages here. The Microsoft APT repos do not exist yet
# during the package-list pass - they are added by hook 0010, so anything from
# them must be installed in a later hook. (docs/BUILD-NOTES.md #10)

ubuntu-desktop-minimal
gnome-shell
gdm3
nautilus
gnome-terminal

# --- Installer ---------------------------------------------------------------
# Deliberately no installer package. os7-setup is authored by OS/7 itself
# (C#/.NET, text mode) and is not an archive package. See
# installer/SETUP-PLAN.md. Calamares was removed on 2026-08-23.

# --- The familiar feel: GNOME's OWN Classic session ---------------------------
# README used to call for dash-to-panel plus ArcMenu. They are not here, and
# the reason is a measurement rather than a preference. Against the pinned
# snapshot 20260824T000000Z, resolute main+universe amd64:
#
#   gnome-shell-extension-dash-to-panel   ABSENT
#   gnome-shell-extension-arc-menu        ABSENT
#   gnome-shell-extension-dashtodock      ABSENT
#   gnome-shell-extensions          50.0-1, Recommends: gnome-classic
#   gnome-shell-extension-window-list     50.0-1
#   gnome-shell-extension-apps-menu       50.0-1
#   gnome-shell-extension-places-menu     50.0-1
#   gnome-shell-extension-user-theme      50.0-1
#
# Every 50.0-1 package above declares `Depends: gnome-shell (>= 50~), (<< 51~)`
# and ships from GNOME's own gnome-shell-extensions source package, so Ubuntu
# moves them in lockstep with gnome-shell 50.1. A third-party Shell extension
# has no such coupling - which is precisely why the first three are missing
# from a released archive four months after GNOME 50, and why building OS/7's
# desktop on them would mean rebuilding it every generation.
#
# The taskbar is window-list; the start menu is apps-menu plus places-menu.
# os7-desktop-theme selects them through /etc/dconf/db/os7.d/.
gnome-shell-extension-window-list
gnome-shell-extension-apps-menu
gnome-shell-extension-places-menu
gnome-shell-extension-launch-new-instance

# user-theme is what loads a Shell stylesheet from /usr/share/themes. Without
# it the GTK side of the theme applies and the panel stays stock GNOME.
gnome-shell-extension-user-theme

# The GNOME Classic session itself, so the tested upstream combination is
# available at the login screen as well as through the dconf defaults.
gnome-classic

# dconf-cli is what compiles /etc/dconf/db/os7.d into the binary database the
# defaults actually come from. os7-desktop-theme depends on it; naming it here
# keeps the theme package's install from depending on dependency resolution
# order inside live-build.
dconf-cli

# The theme itself is NOT in this list. It is built from
# build/packages/os7-desktop-theme/ into config/packages.chroot-amd64/ by
# build/lib/build-desktop-theme.sh, because it is OS/7's own component with
# OS/7's version on it, not an archive package.
