#!/bin/bash
# OS/7 — the classic desktop is present and selected. VERIFY, do not assume.
#
# This hook replaces 0070-gnome-familiarity, which recorded a gap: README asked
# for a dash-to-panel taskbar and an ArcMenu start menu, and neither had a
# GNOME-50-compatible build in the archive. That gap is now CLOSED, from the
# other side: the taskbar and the start menu come from GNOME's own Classic
# extensions, which ship in the same source package as gnome-shell and are
# therefore always in step with it. See
# build/packages/os7-desktop-theme/README.md.
#
# WHAT THIS HOOK IS FOR. Everything the theme needs is declared - in a package
# list, in a .deb's Depends, in a dconf keyfile. Every one of those declarations
# can be satisfied on paper and wrong in the image:
#
#   * live-build runs no hook at all and still exits 0 (BUILD-NOTES #13)
#   * `dconf update` exits 0 for a keyfile it could not parse
#   * fontconfig resolves a missing font family to the default sans face and
#     reports nothing
#
# So each check below asks the installed system a question whose answer cannot
# be produced by the thing being checked.

set -euo pipefail

# One stream, in order. Failures go to stderr and successes to stdout, and when
# live-build redirects both into a log the two buffer independently — measured
# in a container dry run, where "the classic desktop is NOT correctly installed"
# printed BEFORE the last check that had not run yet. A verification log that
# reorders itself is worse than no log.
exec 1>&2

ARCH="$(dpkg --print-architecture)"
if [ "${ARCH}" != "amd64" ]; then
	echo "OS/7 hook 0090: staged on ${ARCH} but this hook is amd64-only - skipping." >&2
	exit 0
fi

echo "OS/7 hook 0090: verifying the classic desktop"

fail=0
note() { echo "OS/7 hook 0090: FAIL: $*" >&2; fail=1; }
ok()   { echo "OS/7 hook 0090:   ok: $*"; }

# --- 1. GNOME's own Classic extensions ----------------------------------
# Ask for the extension DIRECTORY, not for the package: a package can be
# installed and its files diverted, and it is the directory gnome-shell loads.
EXT_DIR="/usr/share/gnome-shell/extensions"
for uuid in \
	window-list@gnome-shell-extensions.gcampax.github.com \
	apps-menu@gnome-shell-extensions.gcampax.github.com \
	places-menu@gnome-shell-extensions.gcampax.github.com \
	user-theme@gnome-shell-extensions.gcampax.github.com
do
	if [ -f "${EXT_DIR}/${uuid}/metadata.json" ]; then
		ok "extension ${uuid%%@*}"
	else
		note "extension missing: ${EXT_DIR}/${uuid}/metadata.json"
	fi
done

# The Shell generation the extensions declare must be the Shell that is here.
# A mismatch is what makes an extension silently refuse to load at login.
SHELL_VER="$(gnome-shell --version 2>/dev/null | sed 's/[^0-9.]//g' | cut -d. -f1 || true)"
META="${EXT_DIR}/window-list@gnome-shell-extensions.gcampax.github.com/metadata.json"
if [ -n "${SHELL_VER}" ] && [ -f "${META}" ]; then
	if grep -q "\"${SHELL_VER}" "${META}"; then
		ok "window-list declares support for GNOME Shell ${SHELL_VER}"
	else
		note "window-list does not list shell-version ${SHELL_VER} - it will not load"
		sed -n 's/.*"shell-version"\(.*\)/  declared:\1/p' "${META}" >&2 || true
	fi
fi

# --- 2. The theme package ------------------------------------------------
# NOTE ON ORDERING: the theme is installed by hook 0085, which runs before this
# one because 0085 sorts before 0090. It no longer arrives through
# config/packages.chroot - live-build signs a local package repository with
# gnupg 1.x code that gnupg 2.x cannot satisfy, so that path kills the build
# outright (BUILD-NOTES #71). The old worry here was that local-packages might
# run after hooks; the measured sequence is chroot_archives 52, includes 77,
# hooks 78, so a hook is now the LAST word on whether the theme is installed and
# this check can be believed. Do not "fix" a failure by making it a warning: if
# 0085 installed it, dpkg knows.
if dpkg -s os7-desktop-theme >/dev/null 2>&1; then
	ok "os7-desktop-theme $(dpkg-query -W -f='${Version}' os7-desktop-theme) installed"
else
	note "os7-desktop-theme is not installed - see the ordering note in this hook"
fi

for f in \
	/usr/share/themes/OS7-Classic/gtk-3.0/gtk.css \
	/usr/share/themes/OS7-Classic/gnome-shell/gnome-shell.css \
	/usr/share/os7-theme/gtk-4.0/os7-classic.css \
	/usr/lib/systemd/user/default.target.wants/os7-theme-user-setup.service
do
	[ -e "${f}" ] && ok "${f}" || note "missing ${f}"
done

# --- 3. The defaults, read back out of the COMPILED database ------------
# Not the keyfile: the keyfile is the input. dconf's binary database is what a
# session actually reads, and it is the only thing that proves the keyfile
# parsed.
if [ -s /etc/dconf/db/os7 ]; then
	ok "/etc/dconf/db/os7 compiled ($(stat -c%s /etc/dconf/db/os7) bytes)"

	check_key() {
		want="$2"
		got="$(DCONF_PROFILE=/etc/dconf/profile/user dconf read "$1" 2>/dev/null || true)"
		if [ "${got}" = "${want}" ]; then
			ok "$1 = ${got}"
		else
			note "$1 reads ${got:-<unset>}, expected ${want}"
		fi
	}
	check_key /org/gnome/desktop/interface/gtk-theme "'OS7-Classic'"
	check_key /org/gnome/shell/extensions/user-theme/name "'OS7-Classic'"
	check_key /org/gnome/desktop/background/primary-color "'#000000'"
	check_key /org/gnome/desktop/wm/preferences/button-layout "':minimize,maximize,close'"
	# THE SESSION, and it is the key the other four depend on. Added
	# 2026-08-26: without it GDM used Ubuntu's default of "ubuntu", whose
	# session mode carries its own Shell stylesheet and its own extension
	# list, and none of the four keys above ever reached a screen. A theme
	# that is installed and not loaded passes every other check in this file.
	check_key /org/gnome/desktop/session/session-name "'gnome-classic'"
	# 1-bit text and GNOME 50 do not agree; docs/BUILD-NOTES.md #84.
	check_key /org/gnome/desktop/interface/font-antialiasing "'grayscale'"
	# The GUI terminal must reach PowerShell the same way the console does, and
	# the only thing that makes it happen is bash being started as a login
	# shell. docs/BUILD-NOTES.md #86.
	check_key "/org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9/login-shell" "true"
	check_key /org/gnome/desktop/default-applications/terminal/exec "'gnome-terminal'"
else
	note "/etc/dconf/db/os7 was not compiled"
fi

# --- 3a. The session the defaults name must EXIST ------------------------
# dconf stores any string at all, and GDM falls back to its own default without
# a word when the name matches no session file. So the value being right is only
# half of it: this asks the filesystem whether the thing it names is here.
#
# Both files come from packages already in the amd64 list - gnome-classic ships
# the .desktop, gnome-shell-common ships the mode - so a failure here means a
# package list changed, not a typo.
for f in /usr/share/wayland-sessions/gnome-classic.desktop \
         /usr/share/gnome-shell/modes/classic.json
do
	[ -e "${f}" ] && ok "${f}" || note "the defaults select gnome-classic and ${f} is missing"
done

# --- 3b. Every key we set is a key GNOME actually has -------------------
# BUILD-NOTES #54. dconf is a key-value store with no knowledge of GSettings
# schemas: a misspelled group or key compiles, stores, and reads back
# perfectly, while GNOME goes on using the default. Reading our own keys back
# out of our own database cannot catch that - both sides come from the same
# file. GSettings is the independent authority, because GSettings is what
# reads these values at login.
#
# This also catches the slow version: a key a future GNOME generation drops,
# leaving a line here that compiles, stores, and does nothing.
# Written in plain shell rather than python3: this hook must not be the reason
# the image needs an interpreter it would not otherwise carry.
echo "OS/7 hook 0090: checking every default against the installed schemas"

KEYFILE="/etc/dconf/db/os7.d/00-os7-classic"
# The greeter's defaults are a SECOND keyfile, in a second database, read
# through a second profile - see section 6. The way a key in it goes stale is
# identical to the way a key in the session's does, so the loop below runs over
# both rather than being written twice.
GREETER_KEYFILE="/usr/share/gdm/dconf/95-os7-login-screen"
ALL_SCHEMAS="$(gsettings list-schemas 2>/dev/null || true)"
# The two lists are DISJOINT, which is the whole reason this second one exists:
# `list-schemas` omits every relocatable schema. See the note at its use below.
RELOC_SCHEMAS="$(gsettings list-relocatable-schemas 2>/dev/null || true)"
if [ -z "${ALL_SCHEMAS}" ]; then
	note "gsettings lists no schemas at all - cannot verify the defaults"
else
	# RELOCATABLE SCHEMAS. A dconf group is a PATH, and for most of GNOME the
	# path happens to spell the schema id with slashes. For a relocatable
	# schema it does not: gnome-terminal's per-profile settings all live under
	# org.gnome.Terminal.Legacy.Profile, instantiated at
	#   /org/gnome/terminal/legacy/profiles:/:<uuid>/
	# The naive transform below turns that into
	#   org.gnome.terminal.legacy.profiles:.:<uuid>
	# which is not a schema, and the check would report "no such schema" for a
	# group that is perfectly correct - a check that fails on right answers gets
	# deleted, and then it stops catching the wrong ones too.
	#
	# So: a table, small and explicit, mapping a group PREFIX to the schema it
	# instantiates. gsettings takes SCHEMA:PATH, so the authority is still
	# GSettings and the question is still "does this key exist" - only the way
	# of naming the schema changes.
	relocatable_schema() {
		case "$1" in
			org/gnome/terminal/legacy/profiles:*) echo "org.gnome.Terminal.Legacy.Profile" ;;
			*) echo "" ;;
		esac
	}

	for kf in "${KEYFILE}" "${GREETER_KEYFILE}"; do
		if [ ! -r "${kf}" ]; then
			note "${kf} is missing - its defaults were never checked"
			continue
		fi
		checked=0
		reloc=0
		group=""
		rawgroup=""
		while IFS= read -r line || [ -n "${line}" ]; do
			case "${line}" in
				\[*\])
					rawgroup="$(printf '%s' "${line}" | tr -d '[]' | sed 's|^/||; s|/$||')"
					group="$(printf '%s' "${rawgroup}" | sed 's|/|.|g')"
					;;
				""|\#*)
					;;
				*=*)
					[ -n "${group}" ] || continue
					key="${line%%=*}"
					key="$(printf '%s' "${key}" | tr -d '[:space:]')"
					checked=$((checked + 1))

					schema="$(relocatable_schema "${rawgroup}")"
					if [ -n "${schema}" ]; then
						reloc=$((reloc + 1))
						# RELOC_SCHEMAS, not ALL_SCHEMAS. `gsettings list-schemas`
						# lists only schemas with a fixed path; a relocatable one is
						# NOT in it, and looking there reported "no such schema"
						# about a schema that was installed and working - which
						# failed a build (1.0.0.114) on a right answer, the exact
						# thing the comment above says a check must not do.
						if ! printf '%s\n' "${RELOC_SCHEMAS}" | grep -qx "${schema}"; then
							note "no such relocatable schema: ${schema} (for key ${key})"
							continue
						fi
						if ! gsettings list-keys "${schema}:/${rawgroup}/" 2>/dev/null | grep -qx "${key}"; then
							note "${schema} at /${rawgroup}/ has no key '${key}'"
						fi
						continue
					fi

					if ! printf '%s\n' "${ALL_SCHEMAS}" | grep -qx "${group}"; then
						note "no such schema: ${group} (for key ${key})"
						continue
					fi
					if ! gsettings list-keys "${group}" 2>/dev/null | grep -qx "${key}"; then
						note "schema ${group} has no key '${key}'"
					fi
					;;
			esac
		done < "${kf}"
		ok "${kf##*/}: ${checked} defaults checked against GNOME's own schema list (${reloc} through a relocatable schema)"
	done
fi

# --- 4. The font ---------------------------------------------------------
# fc-match answers with the face fontconfig WOULD actually use. Asking dpkg
# whether a font package is installed does not answer this question, because a
# font can be present and its family name be something else entirely.
if command -v fc-match >/dev/null 2>&1; then
	MATCH="$(fc-match -f '%{family}' Tahoma 2>/dev/null || true)"
	if [ "${MATCH}" = "Tahoma" ]; then
		ok "fc-match Tahoma -> Tahoma"
	else
		note "fc-match Tahoma -> '${MATCH}': the UI font would silently substitute"
	fi
fi

# --- 5. The terminal, and what it lands in -------------------------------
# The GUI half of a decision the rest of the system already made. OS/7 hands
# interactive human sessions to PowerShell from /etc/profile.d (hook 0050, which
# proves the hand-off itself); this checks the three things that decide whether
# a terminal on a DESKTOP ever gets there.
echo "OS/7 hook 0090: checking the terminal"

# 5a. The profile our defaults write to must be the profile gnome-terminal
#     actually uses. The UUID in the keyfile is gnome-terminal's built-in
#     default, and if a future version changes it our login-shell=true lands in
#     a profile nobody opens - stored, readable, and inert. Ask gnome-terminal.
WANT_UUID="b1dcc9dd-5262-4d8d-a863-c897e6d979b9"
GOT_UUID="$(gsettings get org.gnome.Terminal.ProfilesList default 2>/dev/null | tr -d "'" || true)"
if [ "${GOT_UUID}" = "${WANT_UUID}" ]; then
	ok "gnome-terminal's default profile is the one the defaults configure"
else
	note "gnome-terminal defaults to profile '${GOT_UUID:-<unset>}', the keyfile writes to ${WANT_UUID}"
fi

# 5b. One terminal on the image, and it is the configured one.
if dpkg -s gnome-terminal >/dev/null 2>&1; then
	ok "gnome-terminal installed"
else
	note "gnome-terminal is not installed - nothing carries the login-shell default"
fi
if dpkg -s ptyxis >/dev/null 2>&1; then
	note "ptyxis is still installed - two terminals, and only one lands in PowerShell"
else
	ok "ptyxis is gone (hook 0035)"
fi

# 5c. What "a terminal" resolves to for everything that asks Debian rather than
#     GNOME.
XTERM_ALT="$(readlink -f /etc/alternatives/x-terminal-emulator 2>/dev/null || true)"
case "${XTERM_ALT}" in
	*gnome-terminal*) ok "x-terminal-emulator -> ${XTERM_ALT}" ;;
	"")               note "x-terminal-emulator resolves to nothing" ;;
	*)                note "x-terminal-emulator -> ${XTERM_ALT}, not gnome-terminal" ;;
esac

# 5d. And the thing at the end of the chain. /usr/bin/pwsh is a VERSION-FREE
#     path on purpose - it points into /opt/microsoft/powershell/7, not into a
#     7.6.5 directory - so that "the installed PowerShell" stays true across an
#     upgrade without anything here being edited.
if [ -x /usr/bin/pwsh ]; then
	PWSH_TARGET="$(readlink -f /usr/bin/pwsh || true)"
	ok "/usr/bin/pwsh -> ${PWSH_TARGET}"
	case "${PWSH_TARGET}" in
		*/powershell/7/*) ok "and it is the version-free path, not a pinned directory" ;;
		*) note "/usr/bin/pwsh resolves to ${PWSH_TARGET} - a version-specific path goes stale on upgrade" ;;
	esac
else
	note "/usr/bin/pwsh is missing or not executable - the terminal would land in bash"
fi
[ -r /etc/profile.d/95-os7-powershell.sh ] \
	&& ok "/etc/profile.d/95-os7-powershell.sh" \
	|| note "the PowerShell drop-in is missing - hook 0050 did not run"

# --- 6. The login screen -------------------------------------------------
# The screen the machine shows before anybody has proved who they are, and the
# one surface none of the checks above can see: the greeter reads a DIFFERENT
# database, through a DIFFERENT profile, as a DIFFERENT user. Everything
# section 3 proved about /etc/dconf/db/os7 was true while the login screen said
# Ubuntu.
#
# THE MECHANISM, measured out of the shipped image on 2026-08-29 and re-asked
# here because it is the half that can be taken away by an upgrade:
#
#   /usr/share/dconf/profile/gdm    user-db:user
#                                   file-db:/var/lib/gdm3/greeter-dconf-defaults
#   /usr/share/gdm/generate-config  dconf compile <that file> /usr/share/gdm/dconf
#   gdm.service                     ExecStartPre=/usr/share/gdm/generate-config
#
# There is no `system-db:gdm` anywhere in it, so GNOME's documented
# /etc/dconf/db/gdm.d/ is not a thing on this distribution and a keyfile put
# there is read by nobody. docs/BUILD-NOTES.md #110.
echo "OS/7 hook 0090: checking the login screen"

GDM_PROFILE=/usr/share/dconf/profile/gdm
GDM_DCONF_DIR=/usr/share/gdm/dconf
GDM_GENCONF=/usr/share/gdm/generate-config
WANT_LOGO=/usr/share/pixmaps/os7-logo-login.svg
UBUNTU_LOGO=/usr/share/pixmaps/ubuntu-logo-text-dark.svg

mech=1
if [ -r "${GDM_PROFILE}" ]; then
	prof="$(cat "${GDM_PROFILE}" 2>/dev/null || true)"
	case "${prof}" in
		*file-db:/var/lib/gdm3/greeter-dconf-defaults*)
			ok "${GDM_PROFILE} reads file-db:/var/lib/gdm3/greeter-dconf-defaults" ;;
		*)
			note "${GDM_PROFILE} no longer names that file-db - the greeter defaults are inert"
			mech=0 ;;
	esac
else
	note "${GDM_PROFILE} is missing - gdm3 is not installed on a desktop image"
	mech=0
fi

if [ -r "${GDM_GENCONF}" ]; then
	genconf="$(cat "${GDM_GENCONF}" 2>/dev/null || true)"
	case "${genconf}" in
		*"dconf compile"*"${GDM_DCONF_DIR}"*)
			ok "${GDM_GENCONF} compiles ${GDM_DCONF_DIR}" ;;
		*)
			note "${GDM_GENCONF} no longer compiles ${GDM_DCONF_DIR}"
			mech=0 ;;
	esac
else
	note "${GDM_GENCONF} is missing - nothing recompiles the greeter defaults"
	mech=0
fi

# Our file must SORT LAST in that directory, or it loses to gdm3's own
# 00-upstream-settings and to 90-debian-settings (a symlink to the ucf conffile
# /etc/gdm3/greeter.dconf-defaults). `dconf compile` takes the last writer.
if [ -r "${GREETER_KEYFILE}" ]; then
	LAST="$(ls "${GDM_DCONF_DIR}" 2>/dev/null | grep -v '^locks$' | sort | tail -1 || true)"
	if [ "${LAST}" = "$(basename "${GREETER_KEYFILE}")" ]; then
		ok "${LAST} sorts last in ${GDM_DCONF_DIR} - it out-ranks gdm3's and Debian's"
	else
		note "${LAST} sorts after $(basename "${GREETER_KEYFILE}") - our defaults lose"
	fi
else
	note "${GREETER_KEYFILE} is missing - os7-desktop-theme did not ship the greeter defaults"
	mech=0
fi

# 6a. WHAT THE GREETER WOULD ACTUALLY SHOW.
#
# Not `dconf read`, which would only say that our own keyfile parsed - both
# sides of that question come from this repository. The thing the login screen
# is competing with is a GSCHEMA OVERRIDE:
#
#   /usr/share/glib-2.0/schemas/10_ubuntu-settings.gschema.override
#       [org.gnome.login-screen]  logo='/usr/share/pixmaps/ubuntu-logo-text-dark.svg'
#       [org.gnome.desktop.interface]  accent-color = 'orange'
#
# owned by ubuntu-settings, which ubuntu-desktop-minimal Depends on and which
# therefore cannot be removed. A dconf VALUE beats a schema DEFAULT - that is
# the entire mechanism - and GSettings is the only thing that resolves the two.
# So: compile the directory the way generate-config does, point a profile at
# the result, and ask GSettings.
if [ "${mech}" -eq 1 ]; then
	SCRATCH="$(mktemp -d)"
	if dconf compile "${SCRATCH}/db" "${GDM_DCONF_DIR}" 2>/dev/null; then
		printf 'file-db:%s/db\n' "${SCRATCH}" > "${SCRATCH}/profile"
		greeter_get() {
			DCONF_PROFILE="${SCRATCH}/profile" gsettings get "$1" "$2" 2>/dev/null | tr -d "'" || true
		}
		greeter_key() {
			got="$(greeter_get "$1" "$2")"
			if [ "${got}" = "$3" ]; then
				ok "greeter $1 $2 = ${got}"
			else
				note "greeter $1 $2 reads '${got:-<nothing>}', expected '$3'"
			fi
		}
		greeter_key org.gnome.login-screen      logo             "${WANT_LOGO}"
		greeter_key org.gnome.desktop.interface accent-color     "blue"
		greeter_key org.gnome.desktop.interface font-name        "Tahoma 11"
		greeter_key com.ubuntu.login-screen     background-color "#0057ad"

		# 6b. AND THE CONTROL, because a check that cannot fail is not a check.
		#
		# The same query, against the same directory with our file taken out.
		# It must come back with UBUNTU's logo. If it came back with ours the
		# test above would be proving nothing - the value would be arriving
		# from somewhere else entirely and 95-os7-login-screen could be deleted
		# without anything noticing. Same discipline as #16: never accept a
		# marker the command itself could have produced.
		CONTROL="$(mktemp -d)"
		mkdir -p "${CONTROL}/dir"
		cp -a "${GDM_DCONF_DIR}/." "${CONTROL}/dir/"
		rm -f "${CONTROL}/dir/$(basename "${GREETER_KEYFILE}")"
		if dconf compile "${CONTROL}/db" "${CONTROL}/dir" 2>/dev/null; then
			printf 'file-db:%s/db\n' "${CONTROL}" > "${CONTROL}/profile"
			base="$(DCONF_PROFILE="${CONTROL}/profile" gsettings get org.gnome.login-screen logo 2>/dev/null | tr -d "'" || true)"
			if [ "${base}" = "${UBUNTU_LOGO}" ]; then
				ok "control: without 95-os7-login-screen the greeter shows ${base} - so the check above measures precedence"
			else
				note "control: without our keyfile the greeter shows '${base:-<nothing>}', not ${UBUNTU_LOGO} - the logo check proves nothing"
			fi
		else
			note "control: dconf compile failed on the directory without our keyfile"
		fi
		rm -rf "${CONTROL}"
	else
		note "dconf compile failed on ${GDM_DCONF_DIR} - the greeter defaults would not load"
	fi
	rm -rf "${SCRATCH}"
fi

# 6c. The mark itself, and that it arrived as a PACKAGE rather than as a file
#     somebody copied in. Hook 0035 has already rasterised it with rsvg-convert
#     and failed the build if it did not render; this is the cheap half.
if [ -s "${WANT_LOGO}" ]; then
	owner="$(dpkg -S "${WANT_LOGO}" 2>/dev/null | cut -d: -f1 || true)"
	if [ "${owner}" = "os7-desktop-theme" ]; then
		ok "${WANT_LOGO} ($(stat -c%s "${WANT_LOGO}") bytes) owned by os7-desktop-theme"
	else
		note "${WANT_LOGO} belongs to '${owner:-nobody}' - an unowned file is not replaced by an update"
	fi
else
	note "${WANT_LOGO} is missing or empty - the greeter would draw no logo at all"
fi

# 6d. The greeter's stylesheet. Hook 0035 step 9 moves it off Yaru with
#     update-alternatives; this asks the link where it points. Yaru is not a
#     neutral theme that happens to be installed - it is Ubuntu's brand, and it
#     is what draws the login screen unless something says otherwise.
for altname in gdm-theme.gresource gdm-icons.gresource; do
	got="$(readlink -f "/usr/share/gnome-shell/${altname}" 2>/dev/null || true)"
	case "${got}" in
		"")      note "${altname} resolves to nothing" ;;
		*Yaru*)  note "${altname} -> ${got}: the login screen is themed by Ubuntu" ;;
		*)       ok "${altname} -> ${got}" ;;
	esac
done

if [ "${fail}" -ne 0 ]; then
	echo "OS/7 hook 0090: the classic desktop is NOT correctly installed." >&2
	exit 1
fi

echo "OS/7 hook 0090: done - classic desktop verified"
