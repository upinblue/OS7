#!/bin/bash
# OS/7 — install the classic desktop theme. amd64 only.
#
# WHY THIS HOOK EXISTS AT ALL. The theme used to arrive through
# config/packages.chroot, which is live-build's own mechanism for shipping local
# .debs, and that mechanism cannot be used here: a non-empty packages.chroot
# makes lb_chroot_archives build a local apt repository inside the chroot and
# SIGN it, with gnupg 1.x code. It passes --secret-keyring/--keyring, which
# gnupg >= 2.1 ignores, and its `gpg --batch --gen-key` parameter file has no
# %no-protection, so gpg 2.x wants a passphrase, finds no tty, and the build
# dies with "Inappropriate ioctl for device" and then "signing failed: No secret
# key". BUILD-NOTES #63. Nothing in live-build's configuration turns that off
# without also turning off verification of the pinned snapshot, and no stage
# runs early enough to intervene: chroot_archives is stage 52, ahead of
# chroot_early_hooks (57), chroot_includes (77) and chroot_hooks (78).
#
# So build.sh puts the .deb in config/includes.chroot instead, stage 77 copies
# it into the chroot as an ordinary file, and this hook installs it at stage 78.
# `apt-get install` on a path resolves Depends against the pinned archive the
# same way the package lists do; dpkg -i would not.
#
# ORDERING: this must stay numbered below 0090, which VERIFIES the theme.
# Installing and checking in one hook would be a program marking its own work.

set -euo pipefail

# One stream, in order — same reason as hook 0090: live-build redirects stdout
# and stderr into one log and they buffer independently, so a failure can print
# before the check that had not run yet.
exec 1>&2

ARCH="$(dpkg --print-architecture)"
if [ "${ARCH}" != "amd64" ]; then
	echo "OS/7 hook 0085: staged on ${ARCH} but this hook is amd64-only - skipping."
	exit 0
fi

PKG_DIR="/usr/lib/os7/packages"

shopt -s nullglob
DEBS=( "${PKG_DIR}"/os7-desktop-theme_*_all.deb )
shopt -u nullglob

# Exactly one, and say which. A glob that matched two versions would install
# whichever apt preferred and the ISO would carry a version nobody chose.
if [ "${#DEBS[@]}" -ne 1 ]; then
	echo "OS/7 hook 0085: expected exactly 1 theme .deb in ${PKG_DIR}, found ${#DEBS[@]}"
	ls -la "${PKG_DIR}" 2>/dev/null || echo "  ${PKG_DIR} does not exist"
	exit 1
fi

DEB="${DEBS[0]}"
echo "OS/7 hook 0085: installing $(basename "${DEB}")"

export DEBIAN_FRONTEND=noninteractive
apt-get install -y "${DEB}"

# ASK THE THING ITSELF. apt-get's exit code is a diagnostic; dpkg's database is
# the system. This is the standing rule in this repo and it is cheap here.
if ! dpkg -s os7-desktop-theme >/dev/null 2>&1; then
	echo "OS/7 hook 0085: apt-get exited 0 and os7-desktop-theme is NOT installed"
	exit 1
fi
echo "OS/7 hook 0085: os7-desktop-theme $(dpkg-query -W -f='${Version}' os7-desktop-theme) installed"

# The .deb is a build input, not image content: it would otherwise ship inside
# the squashfs, which is built later, and every installed machine would carry a
# copy of a package it already has.
rm -f "${DEB}"
rmdir "${PKG_DIR}" 2>/dev/null || true

if [ -e "${DEB}" ]; then
	echo "OS/7 hook 0085: ${DEB} is still present and would ship in the image"
	exit 1
fi
echo "OS/7 hook 0085: build input removed from the image"
