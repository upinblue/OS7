# OS/7 boot splash — docs/BRAND-PLAN.md BR8.
#
# WHAT THIS DRAWS. The OS/7 mark on black, its four shapes arriving one after
# another — O, S, 7, and the slash last, cutting in along its own slope — over
# a segmented progress bar in the Windows 2000 idiom. While the machine asks
# for the disk passphrase, the bar's frame becomes the field and the blocks
# become bullets. On shutdown the mark is drawn and the bar is not.
#
# WHAT IT IS MADE OF. Seven PNGs beside this file, every one GENERATED by
# build/lib/brand.py from brand/os7-wordmark.svg and never edited here;
# check-brand.py requires each to decode to the master's pixels. The four mark
# sprites share one canvas the size of the whole mark, so they are placed at
# one point and the script never needs to know where a shape sits.
#
# NO TEXT IN THE MARK, and no assumption that text can be drawn at all. The
# label plugin that Image.Text needs ships on amd64 and NOT on arm64
# (plymouth-label, measured in the 1.0.0.245 manifests). The passphrase PROMPT
# is drawn with Image.Text where it exists and simply left out where it does
# not: the field, the bullets and the waiting machine still say what is wanted.
#
# NOT ON A SERIAL CONSOLE. plymouthd forces the `details` plugin on serial
# consoles ("serial consoles detected, managing them with details forced",
# read out of the shipped plymouthd), so a machine with console=ttyS0 shows
# text there whatever this file says, and the passphrase is asked as
# "Please unlock disk <name>". Measured on a 1.0.0.245 bench, 2026-10-29.
#
# THE LAYOUT NUMBERS BELOW are the only geometry this file states; everything
# else is read off the images. check-brand.py requires each to equal its twin
# in brand.py's SPLASH_LAYOUT, because the frame PNG is drawn for exactly
# these and a block placed by a different number lands on the frame's line.
block_count = 20;
block_inset = 6;
block_pitch = 25;
bullet_inset = 9;
bullet_pitch = 18;

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# ---------------------------------------------------------------- the images
# Scaled ONCE, here, to about a quarter of the screen's width and never above
# native size: Image.Scale is bilinear, and down is sharp where up is soft.
o_native = Image("o.png");
scale = Window.GetWidth() * 0.26 / o_native.GetWidth();
if (scale > 1) scale = 1;

fun scaled(name) {
    local.img = Image(name);
    return img.Scale(Math.Int(img.GetWidth() * global.scale + 0.5),
                     Math.Int(img.GetHeight() * global.scale + 0.5));
}

o_img = scaled("o.png");
s_img = scaled("s.png");
seven_img = scaled("seven.png");
slash_img = scaled("slash.png");
frame_img = scaled("frame.png");
block_img = scaled("block.png");
bullet_img = scaled("bullet.png");

mark_w = o_img.GetWidth();
mark_h = o_img.GetHeight();
mark_x = Window.GetX() + Window.GetWidth() / 2 - mark_w / 2;
mark_y = Window.GetY() + Window.GetHeight() * 0.42 - mark_h / 2;

bar_x = Window.GetX() + Window.GetWidth() / 2 - frame_img.GetWidth() / 2;
bar_y = mark_y + mark_h + Math.Int(54 * scale);

# The slash arrives along its own direction: (26, -64) in the master's units,
# the vector from its foot to its head. 18 units of travel, scaled.
slash_dx = 26 / 69.08;
slash_dy = -64 / 69.08;
slash_travel = 18 * 3 * scale;

o_sprite = Sprite(o_img);
s_sprite = Sprite(s_img);
seven_sprite = Sprite(seven_img);
slash_sprite = Sprite(slash_img);
o_sprite.SetPosition(mark_x, mark_y, 10);
s_sprite.SetPosition(mark_x, mark_y, 10);
seven_sprite.SetPosition(mark_x, mark_y, 10);
slash_sprite.SetPosition(mark_x, mark_y, 11);
o_sprite.SetOpacity(0);
s_sprite.SetOpacity(0);
seven_sprite.SetOpacity(0);
slash_sprite.SetOpacity(0);

frame_sprite = Sprite(frame_img);
frame_sprite.SetPosition(bar_x, bar_y, 10);
frame_sprite.SetOpacity(0);

for (i = 0; i < block_count; i++) {
    blocks[i] = Sprite(block_img);
    blocks[i].SetPosition(bar_x + Math.Int((block_inset + i * block_pitch) * scale),
                          bar_y + Math.Int(block_inset * scale), 12);
    blocks[i].SetOpacity(0);
}

prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
message_sprite = Sprite();

# The bar is a BOOT thing: on shutdown there is nothing to count down to.
show_bar = (Plymouth.GetMode() == "boot");
state = "normal";
frame = 0;
progress = 0;

# ---------------------------------------------------------------- animation
# Plymouth calls this at 50 frames a second. Each shape fades in over ~0.24 s,
# staggered; the slash is last and moves. Ease-out: 1 - (1 - t)^2.
fun appear(start, length) {
    local.t = (global.frame - start) / length;
    if (t < 0) return 0;
    if (t > 1) return 1;
    return 1 - (1 - t) * (1 - t);
}

fun refresh_callback() {
    global.frame++;
    o_sprite.SetOpacity(appear(4, 12));
    s_sprite.SetOpacity(appear(10, 12));
    seven_sprite.SetOpacity(appear(16, 12));

    local.p = appear(28, 14);
    local.away = (1 - p) * slash_travel;
    slash_sprite.SetPosition(mark_x + away * slash_dx, mark_y + away * slash_dy, 11);
    slash_sprite.SetOpacity(p);

    if (global.state == "password") {
        # The field is there the moment the question is: a prompt above an
        # empty screen asks for something nobody can see where to type.
        # (Seen in slow motion on a bench: the frame used to wait for the
        # intro's 40th frame while the prompt text was already drawn.)
        frame_sprite.SetOpacity(0.5);
    }
    if (global.state == "normal" && global.show_bar) {
        local.f = appear(40, 12);
        frame_sprite.SetOpacity(f * 0.5);
        local.lit = Math.Int(global.progress * block_count + 0.0001);
        for (local.i = 0; i < block_count; i++) {
            if (i < lit) blocks[i].SetOpacity(f);
            else blocks[i].SetOpacity(0);
        }
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
    if (progress > global.progress) global.progress = progress;
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---------------------------------------------------------------- the passphrase
fun hide_bullets() {
    for (local.i = 0; global.bullets[i]; i++) global.bullets[i].SetOpacity(0);
}

fun display_password_callback(prompt, count) {
    global.state = "password";
    for (local.i = 0; i < block_count; i++) blocks[i].SetOpacity(0);
    frame_sprite.SetOpacity(0.5);

    # The prompt, where text can be drawn at all (amd64); see the header.
    local.text = Image.Text(prompt, 1, 1, 1);
    if (text) {
        prompt_sprite.SetImage(text);
        prompt_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - text.GetWidth() / 2,
                                  bar_y - text.GetHeight() - Math.Int(12 * scale), 12);
        prompt_sprite.SetOpacity(1);
    }

    # As many bullets as fit in the field; past that the field stays full.
    local.room = Math.Int((frame_img.GetWidth() - 2 * bullet_inset * scale) /
                          (bullet_pitch * scale));
    hide_bullets();
    for (local.i = 0; i < count && i < room; i++) {
        if (!global.bullets[i]) global.bullets[i] = Sprite(bullet_img);
        global.bullets[i].SetPosition(bar_x + Math.Int((bullet_inset + i * bullet_pitch) * scale),
                                      bar_y + Math.Int(bullet_inset * scale), 12);
        global.bullets[i].SetOpacity(1);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    global.state = "normal";
    hide_bullets();
    prompt_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---------------------------------------------------------------- messages
# What the initramfs says through `plymouth message` — cryptsetup's "bad
# password or options" among them. Text again, so amd64 only.
fun display_message_callback(text) {
    local.img = Image.Text(text, 0.75, 0.75, 0.75);
    if (img) {
        message_sprite.SetImage(img);
        message_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - img.GetWidth() / 2,
                                   bar_y + frame_img.GetHeight() + Math.Int(24 * scale), 12);
        message_sprite.SetOpacity(1);
    }
}
Plymouth.SetDisplayMessageFunction(display_message_callback);

fun hide_message_callback(text) {
    message_sprite.SetOpacity(0);
}
Plymouth.SetHideMessageFunction(hide_message_callback);
