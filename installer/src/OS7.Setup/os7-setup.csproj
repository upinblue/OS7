<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OS/7 Setup — the text-mode installer. installer/SETUP-PLAN.md is the design;
    this is Phase 1 of §10, the skeleton: TUI layer, screens 1-3 and 12, the
    error screen and logging. STRICTLY NON-DESTRUCTIVE - nothing here touches a
    disk, and nothing here should until Phase 2.

    Published as a NativeAOT binary (§6.1), which spike S2 measured at 3.2-3.4 MB
    with no .NET runtime needed at run time. That matters because this runs
    before anything else on the machine.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>os7-setup</AssemblyName>
    <RootNamespace>OS7.Setup</RootNamespace>

    <PublishAot>true</PublishAot>

    <!-- LibraryImport generates unsafe marshalling, and termios needs a
         `fixed byte c_cc[32]` because LibraryImport marshals blittable types
         only (docs/BUILD-NOTES.md #22). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- ON, deliberately. L9 wants English and German, and
         InvariantGlobalization=true would make that impossible while shrinking
         the binary and looking like a win. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- The AOT and trim analysers are the whole reason to compile ahead of
         time here: a warning at build time is a screen that would otherwise
         have failed on a machine with no way to debug it. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
