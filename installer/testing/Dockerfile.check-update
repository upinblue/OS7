# OS/7 — the container `check-update-logic.py` runs in.
#
# WHY A CONTAINER. The update train shells out to zfs, mount, chroot, apt-get,
# dpkg-query, update-initramfs, update-grub, gpgv and curl. Every one of them is
# faked here, and a fake has to be on PATH ahead of the real thing — which means
# a filesystem nobody minds being rearranged. It also needs Linux: mount(2) and
# /proc/self/mountinfo are what the assembly check reads, and there is no
# equivalent to fake on macOS.
#
# gnupg IS REAL AND NOT FAKED, deliberately. The signature check is the one part
# of this cmdlet where a fake would test nothing: `gpgv` returning 0 because a
# stub said so proves only that the stub said so. So the check generates a real
# key, signs a real index with it, and then signs another with a DIFFERENT key
# and requires the refusal — the same negative case check-os7-repo.py makes
# about apt.
#
# THE POWERSHELL VERSION IS NOT PINNED HERE. build/config/os7-release.conf is
# the only place in this repository a version number or an archive URL may live
# (CLAUDE.md), so check-update-logic.py reads the pin and passes it in, hash and
# all, exactly as build hook 0020 does for the image itself.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# python3      the check itself and every fake
# util-linux   mount, umount, findmnt — and the real /proc/self/mountinfo
# gnupg        gpg and gpgv, REAL: see the header
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends \
      python3 curl ca-certificates util-linux coreutils findutils diffutils gnupg \
 && rm -rf /var/lib/apt/lists/*

ARG PWSH_VERSION
ARG PWSH_SHA256_x64
ARG PWSH_SHA256_arm64

# The same tarball, the same hash check and the same destination as hook 0020.
# A hash that does not match fails the build rather than producing a container
# that runs the module under something nobody chose.
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "${arch}" in \
      amd64) pa=x64;   sha="${PWSH_SHA256_x64}" ;; \
      arm64) pa=arm64; sha="${PWSH_SHA256_arm64}" ;; \
      *) echo "unsupported architecture ${arch}" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-${pa}.tar.gz"; \
    curl -fsSL -o /tmp/pwsh.tar.gz "${url}"; \
    echo "${sha}  /tmp/pwsh.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/microsoft/powershell/7; \
    tar -xzf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/7; \
    chmod +x /opt/microsoft/powershell/7/pwsh; \
    ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh; \
    rm /tmp/pwsh.tar.gz

# PowerShell is a .NET application and aborts at startup without ICU. Resolved
# from the archive rather than hardcoded, for hook 0020's reason: the soname
# version changes between Ubuntu releases.
RUN set -eu; \
    apt-get update -qq; \
    icu="$(apt-cache search --names-only '^libicu[0-9]+$' | awk '{print $1}' | sort -V | tail -n1)"; \
    [ -n "${icu}" ] || { echo "no libicu in the archive" >&2; exit 1; }; \
    apt-get install -y --no-install-recommends "${icu}"; \
    rm -rf /var/lib/apt/lists/*; \
    pwsh -NoProfile -c '$PSVersionTable.PSVersion.ToString()'
